{
  "$schema": "./node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "orso",
  "version": "0.1.9",
  "identifier": "io.github.blaise1030.orso",
  "build": {
    "frontendDist": "ui",
    "beforeDevCommand": { "script": "./scripts/prepare-sidecar.sh debug", "wait": true },
    "beforeBuildCommand": "./scripts/prepare-sidecar.sh release"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/orso"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
