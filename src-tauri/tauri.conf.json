{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "orso",
  "version": "../package.json",
  "identifier": "com.orso.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "orso",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "url": "splash.html",
        "width": 1280,
        "height": 800
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/orso"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2NzNDNURFODA4RkVENDcKUldSSDdZK0Ezc1Z6Um8zMk9maU9zeW9sTHQ3Z21LMkFucHRnWnZjVzZtb0NYZmdRSVhQT3EvbDYK",
      "endpoints": ["https://github.com/Blaise1030/cms/releases/latest/download/latest.json"]
    }
  }
}
