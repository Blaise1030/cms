---
import { render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import BlogCard from "../../components/BlogCard.astro";
import { href } from "../../lib/href";
import { categoriesOf, formatDate, loadBlog, morePosts } from "../../lib/blog";
import { absoluteUrl, breadcrumbs, organization } from "../../lib/seo";
import { site } from "../../site";

export async function getStaticPaths() {
  const { posts, categories } = await loadBlog();
  return posts.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, categories, newer: posts[index - 1], older: posts[index + 1], more: morePosts(entry, posts) },
  }));
}
const { entry, categories, newer, older, more } = Astro.props;
const { Content } = await render(entry);
const postCategories = categoriesOf(entry, categories);
const path = `/blog/${entry.id}/`;
const cover = entry.data.coverImage?.src;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: entry.data.title,
    description: entry.data.description,
    datePublished: entry.data.pubDate,
    dateModified: entry.data.pubDate,
    url: absoluteUrl(path),
    mainEntityOfPage: absoluteUrl(path),
    image: absoluteUrl(cover ?? site.ogImage),
    keywords: entry.data.tags.length > 0 ? entry.data.tags.join(", ") : undefined,
    author: { "@type": "Organization", name: site.name, url: absoluteUrl("/") },
    publisher: organization(),
  },
  breadcrumbs([{ name: "Home", path: "/" }, { name: "Blog", path: "/blog/" }, { name: entry.data.title, path }]),
];
const navLink = "group block border-t border-line pt-6";
---
<Base title={entry.data.title} description={entry.data.description} type="article" published={entry.data.pubDate} image={cover} imageAlt={entry.data.coverAlt} jsonLd={jsonLd}>
  <article class="page pt-14 md:pt-20">
    <div class="mx-auto max-w-prose">
      <a class="link text-sm text-muted" href={href("/blog/")}>Back to Blog</a>
      <div class="rise mt-10 flex flex-wrap items-center gap-x-4 gap-y-1">
        <time class="label" datetime={entry.data.pubDate}>{formatDate(entry.data.pubDate)}</time>
        {postCategories.map((category) => (
          <a class="label text-accent transition-colors duration-quick ease-gentle hover:text-ink" href={href(`/blog/categories/${category.id}/`)}>{category.title}</a>
        ))}
      </div>
      <h1 class="rise mt-4 text-4xl font-light tracking-display text-ink md:text-5xl">{entry.data.title}</h1>
      <p class="rise-2 mt-6 text-xl text-muted">{entry.data.description}</p>
    </div>
    {entry.data.coverImage && (
      <Image class="rise-3 mx-auto mt-12 h-auto w-full max-w-4xl rounded-lg" src={entry.data.coverImage} alt={entry.data.coverAlt!} widths={[800, 1200, 1600]} sizes="(min-width: 1024px) 56rem, 100vw" loading="eager" />
    )}
    <div class="mx-auto max-w-prose">
      <div class="prose mt-12 max-w-none border-t border-line pt-10 prose-img:h-auto prose-img:max-w-full prose-img:rounded-md"><Content /></div>
      {entry.data.tags.length > 0 && (
        <ul class="mt-10 flex flex-wrap gap-x-4 gap-y-1 text-sm text-muted" aria-label="Tags">
          {entry.data.tags.map((tag) => <li>#{tag}</li>)}
        </ul>
      )}
      {(newer || older) && (
        <nav class="mt-16 grid gap-8 sm:grid-cols-2" aria-label="More posts">
          <div>{newer && <a class={navLink} href={href(`/blog/${newer.id}/`)}><span class="label block">Newer</span><span class="mt-2 block font-medium text-ink decoration-line-strong underline-offset-4 group-hover:underline">{newer.data.title}</span></a>}</div>
          <div class="sm:text-right">{older && <a class={navLink} href={href(`/blog/${older.id}/`)}><span class="label block">Older</span><span class="mt-2 block font-medium text-ink decoration-line-strong underline-offset-4 group-hover:underline">{older.data.title}</span></a>}</div>
        </nav>
      )}
    </div>
  </article>
  {more.length > 0 && (
    <section class="page mt-section" aria-labelledby="keep-reading" data-reveal>
      <h2 class="border-t border-line pt-12 text-3xl font-light tracking-display text-ink" id="keep-reading">Keep reading</h2>
      <div class="mt-12 grid gap-x-8 gap-y-16 sm:grid-cols-2 lg:grid-cols-3">{more.map((post) => <BlogCard post={post} categories={categories} level={3} />)}</div>
    </section>
  )}
</Base>
