---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { href } from "../../lib/href";
const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.localeCompare(a.data.pubDate) || a.id.localeCompare(b.id));
---
<Base title="Blog" description="News and stories from our team.">
  <section class="mx-auto max-w-5xl px-8 py-12">
    <h1 class="mb-8 text-4xl font-bold tracking-tight">Blog</h1>
    {posts.length === 0 ? <p>No blog posts yet. Check back soon for news and stories.</p> : (
      <div class="grid grid-cols-[repeat(auto-fit,minmax(14rem,1fr))] gap-6">{posts.map((post) => (
        <article class="rounded-xl border border-neutral-400/30 p-5">
          <h2 class="text-lg font-semibold"><a class="hover:underline" href={href(`/blog/${post.id}/`)}>{post.data.title}</a></h2>
          <time class="mt-1 block text-sm text-neutral-500" datetime={post.data.pubDate}>{post.data.pubDate}</time>
          <p class="mt-3">{post.data.description}</p>
        </article>
      ))}</div>
    )}
  </section>
</Base>
