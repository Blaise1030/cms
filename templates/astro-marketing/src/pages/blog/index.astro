---
import Base from "../../layouts/Base.astro";
import BlogCard from "../../components/BlogCard.astro";
import BlogFilters from "../../components/BlogFilters.astro";
import PageHeader from "../../components/PageHeader.astro";
import { loadBlog } from "../../lib/blog";
import { breadcrumbs } from "../../lib/seo";
const { posts, categories } = await loadBlog();
const [lead, ...rest] = posts;
---
<Base
  title="Blog"
  description="Product news, practical guides and stories from the team behind Acme."
  jsonLd={[{ "@context": "https://schema.org", "@type": "WebPage", name: "Blog" }, breadcrumbs([{ name: "Home", path: "/" }, { name: "Blog", path: "/blog/" }])]}
>
  <PageHeader title="Blog" description="Product news, practical guides and stories from our team." />
  <div class="page mt-12">
    {posts.length === 0 ? <p class="text-muted">No blog posts yet. Check back soon for news and stories.</p> : (
      <>
        <BlogFilters categories={categories} />
        <div class="mt-12" data-reveal><BlogCard post={lead} categories={categories} variant="lead" /></div>
        {rest.length > 0 && (
          <div class="mt-20 grid gap-x-8 gap-y-16 border-t border-line pt-16 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
            {rest.map((post) => <BlogCard post={post} categories={categories} />)}
          </div>
        )}
      </>
    )}
  </div>
</Base>
