---
const testimonials = [
  { quote: "We went from idea to live site in an afternoon.", author: "Jordan Lee", role: "Founder, Northwind" },
  { quote: "Editing copy has never been this painless.", author: "Sam Rivera", role: "Marketing Lead, Globex" },
];
---

<section class="mx-auto max-w-5xl px-8 py-16" id="testimonials">
  <h2 class="mb-6 text-3xl font-bold tracking-tight">What customers say</h2>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(14rem,1fr))] gap-6">
    {testimonials.map((t) => (
      <figure class="rounded-xl border border-neutral-400/30 p-5">
        <blockquote class="italic">{t.quote}</blockquote>
        <figcaption class="mt-3 text-sm text-neutral-600 dark:text-neutral-400">{t.author}, {t.role}</figcaption>
      </figure>
    ))}
  </div>
</section>
