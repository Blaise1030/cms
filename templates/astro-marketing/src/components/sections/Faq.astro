---
const faqs = [
  { question: "Can I change the design?", answer: "Yes. The landing page is plain Astro components styled with Tailwind." },
  { question: "Where can I host it?", answer: "Anywhere that serves static files, including Cloudflare Pages." },
];
---

<section class="mx-auto max-w-5xl px-8 py-16" id="faq">
  <h2 class="mb-6 text-3xl font-bold tracking-tight">Frequently asked questions</h2>
  <div class="space-y-4">
    {faqs.map((i) => (
      <details class="rounded-xl border border-neutral-400/30 p-5">
        <summary class="cursor-pointer font-semibold">{i.question}</summary>
        <p class="mt-3">{i.answer}</p>
      </details>
    ))}
  </div>
</section>
