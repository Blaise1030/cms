---
const logos = ["Northwind", "Globex", "Initech", "Umbrella"];
---

<section class="mx-auto max-w-5xl px-8 py-16 text-center" id="logos">
  <h2 class="mb-6 text-3xl font-bold tracking-tight">Loved by teams at</h2>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(14rem,1fr))] gap-6 text-neutral-600 dark:text-neutral-400">
    {logos.map((name) => <div>{name}</div>)}
  </div>
</section>
