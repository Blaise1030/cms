---

const plans = [
  {
    name: "Starter",
    summary: "For a team finding its rhythm.",
    price: "$0",
    period: "for up to 5 people",
    features: ["3 active projects", "Milestones, tasks and decisions", "Read-only share links"],
    cta: { label: "Start free", href: "/#" },
    highlighted: false,
  },
  {
    name: "Team",
    summary: "For teams running several projects at once.",
    price: "$8",
    period: "per person, per month",
    features: ["Unlimited projects", "Friday summary emails", "Priority email support"],
    cta: { label: "Start a 14-day trial", href: "/#" },
    highlighted: true,
  },
];
---

<section class="page py-section" id="pricing" data-reveal>
  <div class="max-w-xl">
    <h2 class="text-3xl font-light tracking-display text-ink">Start free. Pay when the team grows.</h2>
    <p class="mt-5 text-muted">Prices in US dollars, billed monthly. Change or cancel your plan at any time.</p>
  </div>
  <div class="mt-14 grid gap-6 md:grid-cols-2">
    {plans.map((plan) => (
      <div class:list={["flex flex-col rounded-xl p-8 md:p-10", plan.highlighted ? "bg-sand" : "border border-line"]}>
        <h3 class="text-xl font-medium text-ink">{plan.name}</h3>
        <p class="mt-1 text-muted">{plan.summary}</p>
        <p class="mt-8 flex items-baseline gap-3">
          <span class="text-5xl font-light tracking-display text-ink">{plan.price}</span>
          <span class="text-sm text-muted">{plan.period}</span>
        </p>
        <ul class="mt-8 flex-1 space-y-3 border-t border-line pt-8">
          {plan.features.map((feature) => (
            <li class="flex items-start gap-3">
              <svg class="mt-1.5 size-4 shrink-0" viewBox="0 0 16 16" aria-hidden="true"><path class="stroke-accent" d="m3.5 8.5 3 3 6-7" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <span>{feature}</span>
            </li>
          ))}
        </ul>
        <a class:list={["mt-10 self-start", plan.highlighted ? "button" : "button-quiet"]} href={plan.cta.href}>{plan.cta.label}</a>
      </div>
    ))}
  </div>
</section>
