---
import { href } from "../../lib/href";
---

<section class="page" id="cta" data-reveal>
  <div class="relative overflow-hidden rounded-xl bg-mist px-6 pt-16 pb-32 text-center md:pt-24 md:pb-40">
    <h2 class="mx-auto max-w-2xl text-3xl font-light tracking-display text-ink md:text-4xl">Plan next week in one sitting</h2>
    <p class="mx-auto mt-5 max-w-measure text-muted">Create a project, add your first milestone and invite the team. The plan is ready before your coffee goes cold.</p>
    <div class="mt-10 flex flex-col items-center gap-4">
      <a class="button" href={href("#pricing")}>Start a free project</a>
      <p class="text-sm text-muted">Free for teams of up to five. No card required.</p>
    </div>
    <svg class="absolute inset-x-0 bottom-0 h-20 w-full md:h-28" viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true">
      <path class="fill-ridge" d="M0 70 120 40l90 30 150-56 120 48 140-38 160 52 130-34 140 30 150-30v138H0Z" />
      <path class="fill-accent" d="M0 120V92c160-26 320-30 470-8 120 18 230 20 330 6 140-20 280-22 400-2v32Z" />
    </svg>
  </div>
</section>
