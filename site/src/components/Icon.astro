---
// Hugeicons glyph for Astro markup, rendered to static SVG at build time (no client JS).
// The set lives in ./icons.tsx; add a name here when an Astro page needs a new one.
import * as icons from "./icons";

const byName = {
  scale: icons.ScaleIcon,
  "file-text": icons.FileTextIcon,
  globe: icons.GlobeIcon,
  "arrow-up-right": icons.ArrowUpRightIcon,
  "arrow-left": icons.ArrowLeftIcon,
  "arrow-right": icons.ArrowRightIcon,
  "chevron-down": icons.ChevronDownIcon,
  "chevron-right": icons.ChevronRightIcon,
  search: icons.SearchIcon,
};

interface Props {
  name: keyof typeof byName;
  class?: string;
  /** Extra attributes for the svg, e.g. data-icon="inline-start" inside a button. */
  [attr: `data-${string}`]: string;
}

const { name, class: className = "size-5", ...rest } = Astro.props;
const Glyph = byName[name];
---

<Glyph className={className} strokeWidth={1.5} {...rest} />
