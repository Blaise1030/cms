---
import { href } from "../lib/href";
import type { BlogCategory } from "../lib/blog";

interface Props {
  categories: BlogCategory[];
  /** Id of the category being shown; omit on the all-posts list. */
  active?: string;
}
const { categories, active } = Astro.props;
const shown = categories.filter((category) => category.posts.length > 0 || category.id === active);
const item =
  "-mb-px shrink-0 border-b border-transparent py-3 text-sm text-muted transition-colors duration-quick ease-gentle hover:text-ink aria-[current=page]:border-accent aria-[current=page]:text-ink";
---

{shown.length > 0 && (
  <nav class="flex gap-8 overflow-x-auto border-b border-line" aria-label="Blog categories">
    <a class={item} href={href("/blog/")} aria-current={active ? undefined : "page"}>All posts</a>
    {shown.map((category) => (
      <a class={item} href={href(`/blog/categories/${category.id}/`)} aria-current={category.id === active ? "page" : undefined}>{category.title}</a>
    ))}
  </nav>
)}
