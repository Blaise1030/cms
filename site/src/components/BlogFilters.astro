---
import { href } from "../lib/href";
import UButton from "@nuxt/ui/components/Button.vue";
import type { BlogCategory } from "../lib/blog";

interface Props {
  categories: BlogCategory[];
  /** Id of the category being shown; omit on the all-posts list. */
  active?: string;
}
const { categories, active } = Astro.props;
const shown = categories.filter((category) => category.posts.length > 0 || category.id === active);
---

{shown.length > 0 && (
  <nav class="-mx-1 flex gap-2 overflow-x-auto px-1 py-1" aria-label="Blog categories">
    <UButton color="neutral" variant={active ? "outline" : "soft"} size="lg" class="shrink-0 rounded-full px-4" label="All posts" to={href("/blog/")} aria-current={active ? undefined : "page"} />
    {shown.map((category) => (
      <UButton
        color="neutral"
        variant={category.id === active ? "soft" : "outline"}
        size="lg"
        class="shrink-0 rounded-full px-4"
        label={category.title}
        to={href(`/blog/categories/${category.id}/`)}
        aria-current={category.id === active ? "page" : undefined}
      />
    ))}
  </nav>
)}
