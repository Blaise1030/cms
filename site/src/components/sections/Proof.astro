---
import { getI18n } from "../../i18n";

const { t } = getI18n(Astro.url);
---

<section class="page mx-auto grid max-w-7xl gap-14 border border-line py-section lg:grid-cols-12 lg:gap-10" id="proof">
  <figure class="lg:col-span-6">
    <p class="text-label font-medium text-muted">{t("home.proof.eyebrow")}</p>
    <blockquote class="mt-7 text-title font-normal tracking-tight text-ink">
      {t("home.proof.quote")}
    </blockquote>
    <figcaption class="mt-7 text-small">
      <span class="font-medium text-ink">Lee Robinson</span>
      <span class="block text-muted">{t("home.proof.source")}</span>
    </figcaption>
  </figure>

  <aside class="border-t border-line pt-8 lg:col-span-6 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-0">
    <p class="text-label font-medium text-muted">{t("home.proof.noteTitle")}</p>
    <p class="mt-5 text-muted">
      {t("home.proof.note")}
    </p>
    <p class="mt-5 text-small font-medium text-ink">
      — Blaise ·
      <a class="link text-ink decoration-line hover:decoration-ink" href="https://blaisetiong.dev" rel="noopener noreferrer">blaisetiong.dev</a>
    </p>
  </aside>
</section>
