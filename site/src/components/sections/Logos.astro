---
const logos = ["Astro", "Markdown", "GitHub", "Claude", "Cursor", "Codex"];
---

<section class="page" id="logos">
  <div class="flex flex-col gap-5 border-y border-line py-7 md:flex-row md:items-center md:gap-12">
    <p class="max-w-[16rem] shrink-0 text-sm text-muted">Works with the stack and agents you already have</p>
    <ul class="flex flex-wrap items-center gap-x-9 gap-y-3 text-base font-medium tracking-tight text-ink">
      {logos.map((name) => <li>{name}</li>)}
    </ul>
  </div>
</section>
