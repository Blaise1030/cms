---
import { href } from "../../lib/href";

const logos = [
  { name: "Astro", file: "astro" },
  { name: "Markdown", file: "markdown" },
  { name: "GitHub", file: "github" },
  { name: "Claude", file: "claude" },
  { name: "Cursor", file: "cursor" },
  { name: "Codex", file: "codex" },
];
---

<section class="mx-auto max-w-7xl border-x border-line py-section" id="logos" aria-label="Works with your stack">
  <p class="page mb-6 text-small text-muted">Works with the stack and agents you already have</p>
  <ul class="grid grid-cols-2 gap-px border-y border-line bg-line sm:grid-cols-3 lg:grid-cols-6">
    {logos.map((logo) => (
      <li class="flex min-h-20 items-center justify-center bg-surface px-4 py-5">
        <span class="inline-flex h-7 w-full max-w-[7.5rem] items-center justify-center">
          <img
            src={href(`/logos/${logo.file}.svg`)}
            alt={logo.name}
            width="120"
            height="32"
            class="logo-on-light h-auto max-h-7 w-auto max-w-full object-contain object-center"
            loading="lazy"
            decoding="async"
          />
          <img
            src={href(`/logos/${logo.file}-on-dark.svg`)}
            alt=""
            width="120"
            height="32"
            class="logo-on-dark h-auto max-h-7 w-auto max-w-full object-contain object-center"
            loading="lazy"
            decoding="async"
            aria-hidden="true"
          />
        </span>
      </li>
    ))}
  </ul>
  <p class="page mt-5 text-small text-muted">
    Same files. Same history. Same deploy — drafts, checkpoints and Publish on the repo you already have.
  </p>
</section>
