---
const logos = ["Astro", "Markdown", "GitHub", "Claude", "Cursor", "Codex"];
---

<section class="page" id="logos" data-reveal>
  <div class="flex flex-col gap-4 border-y border-line py-8 md:flex-row md:items-center md:gap-14">
    <h2 class="label shrink-0">Works with the stack and agents you already have</h2>
    <ul class="flex flex-wrap gap-x-10 gap-y-2 text-lg font-medium tracking-tight text-muted">
      {logos.map((name) => <li>{name}</li>)}
    </ul>
  </div>
</section>
