---
import FaqAccordion from "../vue/FaqAccordion.vue";
import type { FaqItem } from "../vue/FaqAccordion.vue";
import { getI18n } from "../../i18n";

const { t, group, path } = getI18n(Astro.url);
// "{link}" marks where the help-centre link sits in the sentence.
const [introBefore, introAfter = ""] = t("home.faq.intro").split("{link}");
const faqs = Object.values(group<Record<string, FaqItem>>("home.faq.items"));
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<section class="page mx-auto max-w-7xl border-x border-line grid gap-12 py-section md:grid-cols-12 md:gap-10" id="faq">
  <div class="md:col-span-4">
    <h2 class="text-title tracking-display text-ink">{t("home.faq.title")}</h2>
    <p class="mt-5 text-muted">
      {introBefore}<a class="link text-ink" href={path("/help/")}>{t("home.faq.introLink")}</a>{introAfter}
    </p>
  </div>
  <div class="md:col-span-7 md:col-start-6">
    <FaqAccordion client:visible items={faqs} />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />
</section>
