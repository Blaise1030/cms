---
import AppWindow from "../AppWindow.astro";
import StatusChip from "../StatusChip.astro";

const tabs = [
  {
    title: "Content",
    description: "Every collection in the repo, as a list you can use.",
  },
  {
    title: "Preview",
    description: "See the draft on desktop and mobile before anyone else.",
  },
  {
    title: "Publish",
    description: "Checks run first, then one button puts it live.",
  },
  {
    title: "Agent",
    description: "Ask for a page, a pass or a whole new section.",
  },
  {
    title: "History",
    description: "Every save is a checkpoint you can go back to.",
  },
];

const rail = ["Content", "Pages", "Media", "History"];

const entries = [
  { title: "Welcome to Orso", tone: "draft" as const, label: "Draft", updated: "2 min ago", author: "Blaise" },
  { title: "Release notes people read", tone: "live" as const, label: "Published", updated: "Tuesday", author: "Ana" },
  { title: "How we run design reviews", tone: "live" as const, label: "Published", updated: "Monday", author: "Sam" },
  { title: "Plan a launch in a week", tone: "review" as const, label: "In review", updated: "Sunday", author: "Blaise" },
  { title: "Invite your team", tone: "live" as const, label: "Published", updated: "Friday", author: "Ana" },
];

const checks = [
  "Build passed in 42 seconds",
  "24 links checked, none broken",
  "Preview approved by Ana",
  "No conflicts with main",
];

const history = [
  { title: "Published to main", detail: "Blaise · just now", tone: "live" as const, label: "Live" },
  { title: "Shortened the pricing FAQ", detail: "Blaise · 14:20 · a1f9c2e", tone: "neutral" as const, label: "Checkpoint" },
  { title: "New cover image", detail: "Ana · 11:02 · 4c07b81", tone: "neutral" as const, label: "Checkpoint" },
  { title: "Restored from 9 November", detail: "Blaise · Monday · 8e2d114", tone: "neutral" as const, label: "Checkpoint" },
];
---

<section class="page py-section" id="platform" aria-labelledby="platform-heading">
  <div class="grid gap-8 md:grid-cols-12 md:gap-10">
    <div class="md:col-span-7">
      <h2 class="text-3xl tracking-display text-ink md:text-4xl" id="platform-heading">
        Everything between the idea and the live page.
      </h2>
    </div>
    <div class="md:col-span-5 md:pt-1">
      <p class="max-w-measure text-muted">
        Orso is a desk on top of your repo: collections, drafts, previews, an agent and history. The same files your
        developer already uses, without the branch names.
      </p>
    </div>
  </div>

  <div class="mt-12 md:mt-16" data-platform>
    <div class="-mx-5 flex overflow-x-auto border-y border-line px-5 md:mx-0 md:grid md:grid-cols-5 md:px-0" role="tablist" aria-label="What Orso does">
      {tabs.map((tab, index) => (
        <button
          id={`platform-tab-${index}`}
          role="tab"
          type="button"
          aria-selected={index === 0 ? "true" : "false"}
          aria-controls={`platform-panel-${index}`}
          tabindex={index === 0 ? 0 : -1}
          data-tab={index}
          class="group relative min-w-[16rem] shrink-0 border-b border-line px-5 py-5 text-left transition-colors duration-quick ease-gentle hover:bg-sand focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-surface md:min-w-0 md:flex-1 md:border-b-0 md:border-l md:border-line md:first:border-l-0 md:px-6"
        >
          <span class="block text-base font-medium text-ink">{tab.title}</span>
          <span class="mt-1 block text-sm leading-snug text-muted">{tab.description}</span>
          <span class="absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-ink transition-transform duration-gentle ease-gentle group-aria-selected:scale-x-100" aria-hidden="true"></span>
        </button>
      ))}
    </div>

    <div class="mt-5">
      <div id={`platform-panel-0`} role="tabpanel" aria-labelledby="platform-tab-0" tabindex="0" class="h-[36rem] md:h-[40rem]">
        <AppWindow crumbs={["site", "content", "blog"]} class="h-full">
          <div slot="actions">
            <span class="hidden text-xs text-muted sm:block">12 posts</span>
            <StatusChip tone="neutral" label="All content" />
          </div>
          <div class="grid h-full md:grid-cols-[12.5rem_minmax(0,1fr)]" aria-hidden="true">
            <aside class="hidden border-r border-line p-3 md:block">
              <p class="px-2 text-xs text-muted">cms / site</p>
              <ul class="mt-3 space-y-0.5">
                {rail.map((item, index) => (
                  <li class:list={["rounded px-2 py-1.5 text-sm", index === 0 ? "bg-sand font-medium text-ink" : "text-muted"]}>{item}</li>
                ))}
              </ul>
              <p class="mt-6 px-2 text-xs text-muted">Collections</p>
              <ul class="mt-2 space-y-0.5 px-2 text-xs text-muted">
                <li class="py-1">Blog posts</li>
                <li class="py-1">Help docs</li>
                <li class="py-1">Pages</li>
                <li class="py-1">Categories</li>
              </ul>
            </aside>

            <div class="min-w-0 overflow-hidden p-5 md:p-7">
              <div class="flex flex-wrap items-end justify-between gap-4">
                <div>
                  <h3 class="text-xl font-medium tracking-tight text-ink">Blog posts</h3>
                  <p class="mt-1 text-xs text-muted">5 of 12 shown · sorted by last saved</p>
                </div>
                <span class="rounded-md bg-ink px-3 py-1.5 text-xs font-medium text-surface">New post</span>
              </div>

              <div class="mt-5 flex flex-wrap gap-1.5">
                <span class="chip border-ink bg-ink text-surface">All 12</span>
                <span class="chip">Drafts 3</span>
                <span class="chip">In review 2</span>
                <span class="chip">Published 7</span>
              </div>

              <div class="mt-5">
                <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-4 border-b border-line pb-2 text-xs text-muted sm:grid-cols-[minmax(0,1fr)_7rem_auto]">
                  <span>Title</span>
                  <span class="hidden sm:block">Updated</span>
                  <span class="text-right">Status</span>
                </div>
                <ul>
                  {entries.map((entry) => (
                    <li class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-4 border-b border-line py-3 sm:grid-cols-[minmax(0,1fr)_7rem_auto]">
                      <div class="min-w-0">
                        <p class="truncate text-sm font-medium text-ink">{entry.title}</p>
                        <p class="text-xs text-muted">{entry.author} · content/blog/en</p>
                      </div>
                      <span class="hidden text-xs text-muted sm:block">{entry.updated}</span>
                      <StatusChip tone={entry.tone} label={entry.label} />
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </AppWindow>
      </div>

      <div id="platform-panel-1" role="tabpanel" aria-labelledby="platform-tab-1" tabindex="0" class="hidden h-[36rem] md:h-[40rem]">
        <AppWindow crumbs={["site", "preview", "home"]} class="h-full">
          <div slot="actions">
            <span class="hidden font-mono text-xs text-muted md:block">orso.dev/preview/8f2c</span>
            <StatusChip tone="review" label="Preview" />
          </div>
          <div class="grid h-full md:grid-cols-[minmax(0,1fr)_17rem]" aria-hidden="true">
            <div class="flex min-w-0 flex-col bg-sand p-3 md:p-4">
              <div class="flex items-center gap-2 pb-3">
                <span class="rounded border border-line bg-surface px-2.5 py-1 text-xs font-medium text-ink">Desktop</span>
                <span class="rounded px-2.5 py-1 text-xs text-muted">Mobile</span>
                <span class="ml-auto hidden items-center gap-1 text-xs text-status-live sm:flex">
                  <span class="size-1.5 rounded-full bg-current"></span> Live preview
                </span>
              </div>
              <div class="min-h-0 flex-1 overflow-hidden rounded border border-line bg-surface-raised">
                <div class="flex items-center justify-between border-b border-line px-4 py-2.5">
                  <span class="text-xs font-medium text-ink">Orso</span>
                  <span class="hidden gap-4 text-xs text-muted sm:flex"><span>Product</span><span>Blog</span><span>Help</span></span>
                  <span class="rounded bg-ink px-2 py-1 text-[0.625rem] font-medium text-surface">Get Orso</span>
                </div>
                <div class="p-5 md:p-7">
                  <p class="max-w-md text-xl font-medium leading-tight tracking-tight text-ink md:text-2xl">Let your content team edit the site with an agent.</p>
                  <p class="mt-3 max-w-sm text-xs leading-5 text-muted">Drafts, previews and a Publish button on the repo your developer already set up.</p>
                  <div class="mt-4 flex gap-2">
                    <span class="rounded bg-ink px-2.5 py-1 text-[0.625rem] font-medium text-surface">Get Orso</span>
                    <span class="rounded border border-line-strong px-2.5 py-1 text-[0.625rem] font-medium text-ink">See how it works</span>
                  </div>
                  <div class="mt-6 grid gap-3 border-t border-line pt-4 sm:grid-cols-3">
                    <div><p class="text-xs font-medium text-ink">Drafts</p><p class="mt-1 text-[0.6875rem] leading-4 text-muted">Nothing goes live by accident.</p></div>
                    <div><p class="text-xs font-medium text-ink">Agent</p><p class="mt-1 text-[0.6875rem] leading-4 text-muted">Whole pages, in plain English.</p></div>
                    <div><p class="text-xs font-medium text-ink">History</p><p class="mt-1 text-[0.6875rem] leading-4 text-muted">Every save can be restored.</p></div>
                  </div>
                </div>
              </div>
            </div>
            <aside class="hidden border-l border-line p-4 md:block">
              <p class="text-xs font-medium text-ink">Comments</p>
              <div class="mt-3 rounded border border-line bg-surface p-3">
                <p class="text-xs font-medium text-ink">Ana</p>
                <p class="mt-1 text-xs leading-5 text-muted">Can we make this line shorter? It runs into the image on mobile.</p>
                <p class="mt-2 text-[0.6875rem] text-muted">On the hero lead</p>
              </div>
              <div class="mt-3 rounded border border-line bg-surface px-3 py-2 text-xs text-muted">Reply…</div>
              <div class="mt-4 flex items-center justify-between border-t border-line pt-3">
                <span class="text-xs text-muted">2 comments</span>
                <span class="rounded bg-ink px-2 py-1 text-[0.625rem] font-medium text-surface">Approve</span>
              </div>
              <p class="mt-5 text-xs font-medium text-ink">Share</p>
              <div class="mt-2 flex items-center justify-between rounded border border-line bg-surface px-2 py-1.5">
                <span class="truncate font-mono text-[0.625rem] text-muted">orso.dev/preview/8f2c</span>
                <span class="text-[0.625rem] font-medium text-ink">Copy</span>
              </div>
            </aside>
          </div>
        </AppWindow>
      </div>

      <div id="platform-panel-2" role="tabpanel" aria-labelledby="platform-tab-2" tabindex="0" class="hidden h-[36rem] md:h-[40rem]">
        <AppWindow crumbs={["site", "publish"]} class="h-full">
          <div slot="actions"><StatusChip tone="review" label="Ready to publish" /></div>
          <div class="grid h-full place-items-center overflow-y-auto p-4 md:p-6" aria-hidden="true">
            <div class="w-full max-w-lg">
              <div class="rounded-md border border-line bg-surface-raised p-5 md:p-6">
                <div class="flex items-center gap-2 text-xs text-muted">
                  <span class="font-mono">draft/pricing-faq</span>
                  <span class="text-line-strong">→</span>
                  <span class="font-mono">main</span>
                </div>
                <h3 class="mt-3 text-xl font-medium tracking-tight text-ink">Publish 3 changes</h3>
                <p class="mt-1 text-sm text-muted">This saves a checkpoint, merges the draft and lets your host rebuild.</p>

                <ul class="mt-5 space-y-2.5 border-t border-line pt-4">
                  {checks.map((check) => (
                    <li class="flex items-center gap-2.5 text-sm text-ink">
                      <span class="flex size-4 items-center justify-center rounded-full bg-status-live/10 text-status-live">
                        <svg class="size-2.5" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 6.5 5 9l4.5-5.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      </span>
                      {check}
                    </li>
                  ))}
                </ul>

                <div class="mt-5 rounded border border-line bg-sand p-3 font-mono text-[0.6875rem] leading-5 text-muted">
                  <p class="text-ink">src/pages/pricing.astro <span class="text-status-live">+18</span> <span class="text-status-draft">−4</span></p>
                  <p>src/content/faq/en/pricing.md <span class="text-status-live">+6</span> <span class="text-status-draft">−1</span></p>
                  <p>src/components/Pricing.astro <span class="text-status-live">+9</span></p>
                </div>

                <div class="mt-5 flex flex-wrap items-center gap-2">
                  <span class="rounded-md bg-ink px-3 py-2 text-sm font-medium text-surface">Publish to main</span>
                  <span class="rounded-md border border-line-strong px-3 py-2 text-sm font-medium text-ink">Keep as draft</span>
                </div>
                <p class="mt-3 text-xs text-muted">Only people with access to this repo can publish.</p>
              </div>
            </div>
          </div>
        </AppWindow>
      </div>

      <div id="platform-panel-3" role="tabpanel" aria-labelledby="platform-tab-3" tabindex="0" class="hidden h-[36rem] md:h-[40rem]">
        <AppWindow crumbs={["site", "agent"]} class="h-full">
          <div slot="actions"><StatusChip tone="draft" label="Draft ready" /></div>
          <div class="grid h-full md:grid-cols-[minmax(0,1fr)_17rem]" aria-hidden="true">
            <div class="flex min-w-0 flex-col p-4 md:p-6">
              <div class="flex items-center gap-2 border-b border-line pb-3">
                <span class="text-xs font-medium text-ink">Agent</span>
                <span class="chip">Claude</span>
                <span class="chip">Cursor</span>
                <span class="chip">Codex</span>
              </div>
              <div class="min-h-0 flex-1 space-y-4 overflow-hidden py-4">
                <div class="ml-auto max-w-md rounded-md bg-sand px-3 py-2.5 text-sm text-ink">
                  Build a landing page for group bookings with our usual hero and FAQ.
                </div>
                <div class="max-w-md">
                  <p class="text-xs font-medium text-ink">Orso</p>
                  <p class="mt-1 text-sm leading-6 text-muted">Done. I reused the hero, pricing table and FAQ from the site, and left the copy as placeholders for review.</p>
                  <div class="mt-3 space-y-1.5 rounded border border-line bg-surface p-3 font-mono text-[0.6875rem]">
                    <p class="text-ink">+ src/pages/group-bookings.astro</p>
                    <p class="text-ink">+ src/content/pages/en/group-bookings.md</p>
                    <p class="text-muted">~ src/site.ts</p>
                  </div>
                  <div class="mt-3 flex items-center gap-2">
                    <span class="rounded-md bg-ink px-2.5 py-1 text-xs font-medium text-surface">Open preview</span>
                    <span class="rounded-md border border-line-strong px-2.5 py-1 text-xs font-medium text-ink">View changes</span>
                  </div>
                </div>
              </div>
              <div class="flex items-center gap-2 rounded-md border border-line bg-surface px-3 py-2">
                <span class="text-sm text-muted">Ask for a change…</span>
                <span class="ml-auto rounded bg-ink px-2 py-1 text-[0.625rem] font-medium text-surface">Send</span>
              </div>
            </div>
            <aside class="hidden border-l border-line p-4 md:block">
              <p class="text-xs font-medium text-ink">This draft</p>
              <div class="mt-3 overflow-hidden rounded border border-line">
                <div class="border-b border-line bg-sand px-2 py-1.5 text-[0.625rem] text-muted">group-bookings</div>
                <div class="p-3">
                  <div class="h-1.5 w-16 rounded-full bg-ink"></div>
                  <div class="mt-2 h-1.5 w-24 rounded-full bg-line"></div>
                  <div class="mt-1 h-1.5 w-20 rounded-full bg-line"></div>
                  <div class="mt-3 h-10 rounded bg-sand"></div>
                  <div class="mt-2 grid grid-cols-3 gap-1"><span class="h-6 rounded bg-sand"></span><span class="h-6 rounded bg-sand"></span><span class="h-6 rounded bg-sand"></span></div>
                </div>
              </div>
              <p class="mt-4 text-xs text-muted">3 files · +46 −2</p>
              <p class="mt-1 text-xs text-muted">Draft in content/pages</p>
              <div class="mt-4 border-t border-line pt-3">
                <p class="text-xs font-medium text-ink">Your agent</p>
                <p class="mt-1 text-xs leading-5 text-muted">Use the one your team already pays for. Orso only needs the repo.</p>
              </div>
            </aside>
          </div>
        </AppWindow>
      </div>

      <div id="platform-panel-4" role="tabpanel" aria-labelledby="platform-tab-4" tabindex="0" class="hidden h-[36rem] md:h-[40rem]">
        <AppWindow crumbs={["site", "history"]} class="h-full">
          <div slot="actions"><StatusChip tone="live" label="Live" /></div>
          <div class="grid h-full md:grid-cols-[minmax(0,1fr)_16rem]" aria-hidden="true">
            <div class="min-w-0 p-5 md:p-7">
              <div class="flex items-end justify-between gap-4">
                <div>
                  <h3 class="text-xl font-medium tracking-tight text-ink">History</h3>
                  <p class="mt-1 text-xs text-muted">Every save is a checkpoint. Nothing is lost.</p>
                </div>
                <span class="chip">main</span>
              </div>
              <ol class="mt-6">
                {history.map((item, index) => (
                  <li class="relative grid grid-cols-[auto_minmax(0,1fr)_auto] gap-3 border-t border-line py-4">
                    <span class:list={["mt-1.5 size-2 rounded-full", index === 0 ? "bg-status-live" : "bg-line-strong"]}></span>
                    <div class="min-w-0">
                      <p class="text-sm font-medium text-ink">{item.title}</p>
                      <p class="mt-0.5 font-mono text-[0.6875rem] text-muted">{item.detail}</p>
                    </div>
                    <span class="text-xs text-muted">{index === 0 ? "Live" : "Restore"}</span>
                  </li>
                ))}
              </ol>
              <p class="mt-4 text-xs text-muted">Older checkpoints load as you scroll.</p>
            </div>
            <aside class="hidden border-l border-line p-4 md:block">
              <p class="text-xs font-medium text-ink">Checkpoint</p>
              <p class="mt-2 font-mono text-sm text-ink">a1f9c2e</p>
              <p class="mt-1 text-xs text-muted">Blaise · today, 14:20</p>
              <div class="mt-4 rounded border border-line bg-surface p-3 text-xs leading-5 text-muted">
                <p class="text-ink">Shortened the pricing FAQ</p>
                <p class="mt-2">4 files changed</p>
                <p><span class="text-status-live">+38</span> <span class="text-status-draft">−12</span></p>
              </div>
              <div class="mt-4 flex items-center gap-2">
                <span class="rounded-md bg-ink px-2.5 py-1 text-xs font-medium text-surface">Restore</span>
                <span class="rounded-md border border-line-strong px-2.5 py-1 text-xs font-medium text-ink">Compare</span>
              </div>
              <p class="mt-5 border-t border-line pt-3 text-xs leading-5 text-muted">Restoring makes a new draft. It never rewrites the history you already have.</p>
            </aside>
          </div>
        </AppWindow>
      </div>
    </div>
  </div>

  <script>
    const initPlatformTabs = () => {
      document.querySelectorAll<HTMLElement>("[data-platform]").forEach((root) => {
        if (root.dataset.ready) return;
        root.dataset.ready = "true";
        const tabs = Array.from(root.querySelectorAll<HTMLElement>('[role="tab"]'));
        const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

        const select = (index: number, focus = false) => {
          tabs.forEach((tab, i) => {
            const active = i === index;
            tab.setAttribute("aria-selected", active ? "true" : "false");
            tab.tabIndex = active ? 0 : -1;
            panels[i].hidden = !active;
          });
          if (focus) tabs[index].focus();
        };

        tabs.forEach((tab, index) => tab.addEventListener("click", () => select(index)));

        root.addEventListener("keydown", (event) => {
          const current = tabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true");
          let next = current;
          if (event.key === "ArrowRight") next = (current + 1) % tabs.length;
          else if (event.key === "ArrowLeft") next = (current - 1 + tabs.length) % tabs.length;
          else if (event.key === "Home") next = 0;
          else if (event.key === "End") next = tabs.length - 1;
          else return;
          event.preventDefault();
          select(next, true);
        });
      });
    };
    document.addEventListener("astro:page-load", initPlatformTabs);
  </script>
</section>
