---
import { OpsCarousel } from "../react/OpsCarousel";
---

<section class="py-section" id="scale">
  <div class="page">
    <div class="max-w-2xl">
      <h2 class="text-3xl tracking-display text-ink md:text-4xl">Handle content work at scale</h2>
      <p class="mt-4 max-w-measure text-muted">
        The desk your team uses for drafts, previews, Publish and history — built on the repo your developer already set
        up.
      </p>
    </div>
  </div>

  <div class="mt-10">
    <OpsCarousel client:visible />
  </div>
</section>
