---
import StatusChip from "../StatusChip.astro";

const slides = [
  {
    title: "Collections you can browse",
    caption: "Every Markdown collection in the repo, as a list with status.",
    kind: "content" as const,
  },
  {
    title: "Desktop and mobile preview",
    caption: "Share a draft link, leave comments, approve before Publish.",
    kind: "preview" as const,
  },
  {
    title: "Publish with a checklist",
    caption: "Build, links and review run first. One button puts it live.",
    kind: "publish" as const,
  },
  {
    title: "Ask in plain English",
    caption: "Whole pages, a pass on the FAQ, or a new section — as a draft.",
    kind: "agent" as const,
  },
  {
    title: "Checkpoints you can restore",
    caption: "Every save is history. Restoring makes a new draft, never a rewrite.",
    kind: "history" as const,
  },
];
---

<section class="page py-section" id="scale">
  <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
    <div class="max-w-2xl">
      <h2 class="text-3xl tracking-display text-ink md:text-4xl">Handle content work at scale</h2>
      <p class="mt-4 max-w-measure text-muted">
        The desk your team uses for drafts, previews, Publish and history — built on the repo your developer already
        set up.
      </p>
    </div>
    <div class="flex gap-2" data-ops-controls>
      <button
        type="button"
        class="flex size-10 items-center justify-center rounded-full border border-line-strong text-ink transition-colors duration-quick ease-gentle hover:bg-sand focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        data-ops-prev
        aria-label="Previous slide"
      >
        <svg class="size-4" viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
      <button
        type="button"
        class="flex size-10 items-center justify-center rounded-full border border-line-strong text-ink transition-colors duration-quick ease-gentle hover:bg-sand focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        data-ops-next
        aria-label="Next slide"
      >
        <svg class="size-4" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
    </div>
  </div>

  <div class="mt-10 -mx-[var(--spacing-gutter)] overflow-hidden md:-mx-[var(--spacing-gutter-wide)]" data-ops>
    <ul class="flex gap-5 overflow-x-auto px-[var(--spacing-gutter)] pb-2 scroll-smooth md:px-[var(--spacing-gutter-wide)]" data-ops-track>
      {slides.map((slide) => (
        <li class="w-[min(100%,22rem)] shrink-0 snap-start md:w-[28rem]">
          <article class="overflow-hidden rounded-md border border-line bg-surface-raised">
            <div class="flex min-h-11 items-center gap-2 border-b border-line px-4">
              <span class="font-mono text-xs text-muted">orso</span>
              <span class="text-line-strong" aria-hidden="true">/</span>
              <span class="text-xs text-muted">{slide.kind}</span>
              <span class="ml-auto">
                {slide.kind === "content" && <StatusChip tone="neutral" label="12 posts" />}
                {slide.kind === "preview" && <StatusChip tone="review" label="Preview" />}
                {slide.kind === "publish" && <StatusChip tone="review" label="Ready" />}
                {slide.kind === "agent" && <StatusChip tone="draft" label="Draft ready" />}
                {slide.kind === "history" && <StatusChip tone="live" label="Live" />}
              </span>
            </div>
            <div class="space-y-3 bg-sand p-5" aria-hidden="true">
              {slide.kind === "content" && (
                <div class="space-y-2 rounded border border-line bg-surface-raised p-3">
                  {["Welcome to Orso", "Release notes people read", "Plan a launch in a week"].map((title, i) => (
                    <div class="flex items-center justify-between gap-3 border-b border-line py-2 last:border-0">
                      <span class="truncate text-sm text-ink">{title}</span>
                      <StatusChip tone={i === 0 ? "draft" : i === 2 ? "review" : "live"} label={i === 0 ? "Draft" : i === 2 ? "Review" : "Live"} />
                    </div>
                  ))}
                </div>
              )}
              {slide.kind === "preview" && (
                <div class="rounded border border-line bg-surface-raised p-4">
                  <div class="h-2 w-24 rounded-full bg-ink"></div>
                  <div class="mt-3 h-2 w-40 rounded-full bg-line"></div>
                  <div class="mt-2 h-2 w-32 rounded-full bg-line"></div>
                  <div class="mt-5 grid grid-cols-3 gap-2">
                    <span class="h-14 rounded bg-sand"></span>
                    <span class="h-14 rounded bg-sand"></span>
                    <span class="h-14 rounded bg-sand"></span>
                  </div>
                </div>
              )}
              {slide.kind === "publish" && (
                <div class="rounded border border-line bg-surface-raised p-4">
                  <p class="text-sm font-medium text-ink">Publish 3 changes</p>
                  <ul class="mt-3 space-y-2 text-xs text-muted">
                    <li class="flex items-center gap-2"><span class="size-1.5 rounded-full bg-status-live"></span>Build passed</li>
                    <li class="flex items-center gap-2"><span class="size-1.5 rounded-full bg-status-live"></span>Links checked</li>
                    <li class="flex items-center gap-2"><span class="size-1.5 rounded-full bg-status-live"></span>Preview approved</li>
                  </ul>
                  <span class="mt-4 inline-block rounded-md bg-ink px-3 py-1.5 text-xs font-medium text-surface">Publish to main</span>
                </div>
              )}
              {slide.kind === "agent" && (
                <div class="space-y-3">
                  <div class="ml-auto max-w-[85%] rounded-md bg-surface-raised px-3 py-2 text-xs text-ink">Tighten the pricing FAQ and add a refund line.</div>
                  <div class="max-w-[85%] rounded-md border border-line bg-surface-raised px-3 py-2 text-xs text-muted">Draft ready. Open the preview when you want to check it.</div>
                </div>
              )}
              {slide.kind === "history" && (
                <div class="rounded border border-line bg-surface-raised p-3">
                  {["Published to main", "Shortened the pricing FAQ", "New cover image"].map((title, i) => (
                    <div class="flex items-center gap-3 border-b border-line py-2.5 last:border-0">
                      <span class:list={["size-2 rounded-full", i === 0 ? "bg-status-live" : "bg-line-strong"]}></span>
                      <span class="text-sm text-ink">{title}</span>
                    </div>
                  ))}
                </div>
              )}
            </div>
            <div class="border-t border-line px-5 py-4">
              <h3 class="text-base font-medium text-ink">{slide.title}</h3>
              <p class="mt-1 text-sm text-muted">{slide.caption}</p>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  const initOps = () => {
    document.querySelectorAll<HTMLElement>("[data-ops]").forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = "true";
      const track = root.querySelector<HTMLElement>("[data-ops-track]");
      const section = root.closest("section");
      const prev = section?.querySelector<HTMLButtonElement>("[data-ops-prev]");
      const next = section?.querySelector<HTMLButtonElement>("[data-ops-next]");
      if (!track || !prev || !next) return;
      const step = () => Math.min(track.clientWidth * 0.85, 448);
      prev.addEventListener("click", () => track.scrollBy({ left: -step(), behavior: "smooth" }));
      next.addEventListener("click", () => track.scrollBy({ left: step(), behavior: "smooth" }));
    });
  };
  document.addEventListener("astro:page-load", initOps);
</script>
