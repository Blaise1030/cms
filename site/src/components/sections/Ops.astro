---
import OpsCarousel from "../vue/OpsCarousel.vue";
import { appShot } from "../../lib/appShots";
import { getI18n } from "../../i18n";

const { t, group } = getI18n(Astro.url);

const shots = {
  content: await appShot("ops-content"),
  preview: await appShot("ops-preview"),
  publish: await appShot("ops-publish"),
  agent: await appShot("ops-agent"),
  history: await appShot("ops-history"),
};
---

<section class="mx-auto max-w-7xl border border-line pt-10 md:pt-12" id="scale">
  <div class="page">
    <div class="max-w-2xl">
      <h2 class="text-title tracking-display text-ink">{t("home.ops.title")}</h2>
      <p class="mt-4 max-w-measure text-muted">
        {t("home.ops.body")}
      </p>
    </div>
  </div>

  <div class="mt-6">
    <OpsCarousel client:visible shots={shots} copy={group("home.ops.slides")} />
  </div>
</section>
