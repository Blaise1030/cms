---
import { buttonVariants } from "../ui/button";
import Icon from "../Icon.astro";

const facts = [
  { title: "Free and open source", detail: "MIT licence, no paid tier.", icon: "scale" as const },
  { title: "Content stays in your repo", detail: "Plain Markdown you already own.", icon: "file-text" as const },
  { title: "Static files, any host", detail: "No runtime and no lock-in.", icon: "globe" as const },
];
---

<section class="page" id="cta">
  <div class="border-t border-line py-16 md:py-20">
    <div class="grid gap-10 md:grid-cols-12 md:items-end md:gap-10">
      <div class="md:col-span-7">
        <h2 class="max-w-xl text-4xl tracking-display text-ink md:text-5xl">Ready to let your team run the site?</h2>
      </div>
      <div class="md:col-span-5 md:border-l md:border-line md:pl-10">
        <p class="max-w-measure text-muted">
          Your developer connects the repo once. Everyone else is editing in minutes — drafts, previews and Publish.
        </p>
        <a
          class={`${buttonVariants({ size: "lg" })} mt-8`}
          href="https://github.com/Blaise1030/cms"
          rel="noopener noreferrer">Get Orso on GitHub</a
        >
      </div>
    </div>

    <ul class="mt-16 grid divide-y divide-line border-t border-line sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      {facts.map((fact) => (
        <li class="py-6 sm:px-6 sm:first:pl-0 sm:last:pr-0">
          <span class="flex size-9 items-center justify-center rounded-md border border-line bg-surface-raised text-ink">
            <Icon name={fact.icon} class="size-5" />
          </span>
          <p class="mt-4 text-sm font-medium text-ink">{fact.title}</p>
          <p class="mt-1 text-sm text-muted">{fact.detail}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
