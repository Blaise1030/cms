---
const facts = [
  { title: "Free and open source", detail: "MIT licence, no paid tier." },
  { title: "Content stays in your repo", detail: "Plain Markdown you already own." },
  { title: "Static files, any host", detail: "No runtime and no lock-in." },
];
---

<section class="page py-section" id="cta">
  <div class="grid gap-10 border-y border-line py-14 md:grid-cols-12 md:items-end md:py-20">
    <div class="md:col-span-8">
      <h2 class="text-4xl tracking-display text-ink md:text-5xl">Let your team run the site. The repo stays yours.</h2>
    </div>
    <div class="flex flex-col items-start gap-4 md:col-span-4 md:items-end">
      <p class="max-w-sm text-muted md:text-right">
        Your developer connects the repo once, and everyone else is editing in minutes.
      </p>
      <a class="button" href="https://github.com/Blaise1030/cms" rel="noopener noreferrer">Get Orso on GitHub</a>
    </div>
  </div>

  <ul class="grid gap-6 pt-8 md:grid-cols-3">
    {facts.map((fact) => (
      <li class="border-l border-line pl-4">
        <p class="text-sm font-medium text-ink">{fact.title}</p>
        <p class="mt-1 text-sm text-muted">{fact.detail}</p>
      </li>
    ))}
  </ul>
</section>
