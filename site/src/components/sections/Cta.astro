---
import { Button } from "../ui/button";
import { Separator } from "../ui/separator";

const facts = [
  { title: "Free and open source", detail: "MIT licence, no paid tier." },
  { title: "Content stays in your repo", detail: "Plain Markdown you already own." },
  { title: "Static files, any host", detail: "No runtime and no lock-in." },
];
---

<section class="page py-section" id="cta">
  <div class="mx-auto max-w-2xl py-16 text-center md:py-20">
    <Separator class="mb-16" />
    <h2 class="text-3xl tracking-display text-ink md:text-5xl">Ready to let your team run the site?</h2>
    <p class="mx-auto mt-5 max-w-measure text-muted">
      Your developer connects the repo once. Everyone else is editing in minutes — drafts, previews and Publish.
    </p>
    <Button asChild size="lg" className="mt-8">
      <a href="https://github.com/Blaise1030/cms" rel="noopener noreferrer">Get Orso on GitHub</a>
    </Button>
    <Separator class="mt-16" />
  </div>

  <ul class="grid gap-6 md:grid-cols-3">
    {facts.map((fact) => (
      <li class="border-l border-line pl-4 text-left">
        <p class="text-sm font-medium text-ink">{fact.title}</p>
        <p class="mt-1 text-sm text-muted">{fact.detail}</p>
      </li>
    ))}
  </ul>
</section>
