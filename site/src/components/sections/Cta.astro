---
import { buttonVariants } from "../ui/button";
import Icon from "../Icon.astro";
import { DownloadButton } from "../react/DownloadButton";

const facts = [
  { title: "Free and open source", detail: "MIT licence, no paid tier.", icon: "scale" as const },
  { title: "Content stays in your repo", detail: "Plain Markdown you already own.", icon: "file-text" as const },
  { title: "Static files, any host", detail: "No runtime and no lock-in.", icon: "globe" as const },
];

const installCommand = "brew install blaise1030/tap/orso && orso serve --open";
---

<section class="mx-auto w-full max-w-7xl border border-line" id="cta">
  <div>
    <div class="grid md:grid-cols-12">
      <div class="px-6 pt-6 pb-8 md:col-span-7 md:px-10 md:pt-8 md:pb-10">
        <h2 class="max-w-xl text-title tracking-display text-ink">Ready to let your team run the site?</h2>
      </div>
      <div class="border-t border-line px-6 py-8 md:col-span-5 md:border-t-0 md:border-l md:px-10 md:py-10">
        <p class="max-w-measure text-muted">
          You install Orso and connect the repo once. After that, your team edits with drafts, previews and Publish.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <DownloadButton client:visible />
          <a
            class={buttonVariants({ variant: "outline", size: "lg" })}
            href="https://github.com/Blaise1030/cms"
            rel="noopener noreferrer">View on GitHub</a
          >
        </div>
        <p class="mt-2 text-small text-muted">macOS and Linux. Prefer Homebrew? <code class="text-ink">{installCommand}</code></p>
      </div>
    </div>

    <ul class="grid divide-y divide-line border-t border-line sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      {facts.map((fact) => (
        <li class="px-6 py-6 md:px-10 md:py-8">
          <span class="flex size-9 items-center justify-center rounded-md border border-line bg-surface-raised text-ink">
            <Icon name={fact.icon} class="size-5" />
          </span>
          <p class="mt-4 text-small font-medium text-ink">{fact.title}</p>
          <p class="mt-1 text-small text-muted">{fact.detail}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

