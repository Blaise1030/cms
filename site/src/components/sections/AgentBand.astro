---
import Painting from "../Painting.astro";
import { AppShot } from "../react/AppShot";
import { buttonVariants } from "../ui/button";
import { appShot } from "../../lib/appShots";
import { href } from "../../lib/href";

const shot = await appShot("agent-band");
---

<section class="page mx-auto max-w-7xl border-x border-line py-section" id="agent">
  <div class="grid gap-8 md:grid-cols-12 md:items-end md:gap-10">
    <div class="md:col-span-7">
      <h2 class="text-title tracking-display text-ink">
        Ship pages faster with an agent on your repo
      </h2>
    </div>
    <div class="flex flex-wrap gap-2 md:col-span-5 md:justify-end">
      <a class={buttonVariants({ variant: "outline", size: "lg" })} href={href("#product")}>Agentic editing</a>
      <a class={buttonVariants({ variant: "outline", size: "lg" })} href={href("#faq")}>Which agents work</a>
    </div>
  </div>

  <div class="relative mt-10 overflow-hidden rounded-md border border-line lg:aspect-video">
    <Painting id="alps" />
    <div class="absolute inset-0 bg-night/25" aria-hidden="true"></div>
    <div class="relative flex flex-col p-4 lg:size-full lg:items-center lg:justify-center lg:p-6">
      <AppShot
        shot={shot}
        alt="Orso's agent panel beside the site preview, where a teammate asks for changes in plain English."
        sizes="(min-width: 80rem) 76rem, 100vw"
        play
        className="w-full lg:h-full lg:w-auto lg:max-w-full"
      />
    </div>
  </div>
</section>
