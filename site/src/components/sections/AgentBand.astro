---
import AppWindow from "../AppWindow.astro";
import Painting from "../Painting.astro";
import StatusChip from "../StatusChip.astro";
import { Badge } from "../ui/badge";
import { Button, buttonVariants } from "../ui/button";
import { href } from "../../lib/href";
---

<section class="page mx-auto max-w-7xl py-section" id="agent">
  <div class="grid gap-8 md:grid-cols-12 md:items-end md:gap-10">
    <div class="md:col-span-7">
      <h2 class="text-title tracking-display text-ink">
        Ship pages faster with an agent on your repo
      </h2>
    </div>
    <div class="flex flex-wrap gap-2 md:col-span-5 md:justify-end">
      <a class={buttonVariants({ variant: "outline", size: "lg" })} href={href("#product")}>Agentic editing</a>
      <a class={buttonVariants({ variant: "outline", size: "lg" })} href={href("#faq")}>Which agents work</a>
    </div>
  </div>

  <div class="relative mt-10 overflow-hidden rounded-md border border-line lg:aspect-video">
    <Painting id="alps" />
    <div class="absolute inset-0 bg-night/30" aria-hidden="true"></div>
    <div class="relative flex flex-col p-4 lg:size-full lg:items-center lg:justify-center lg:p-6">
      <AppWindow
        crumbs={["site", "agent"]}
        class="h-auto md:h-[28rem] lg:aspect-video lg:h-full lg:w-auto lg:max-w-full"
      >
      <div slot="actions" class="flex items-center gap-2"><StatusChip tone="draft" label="Draft ready" /></div>
      <div class="grid h-full md:grid-cols-[minmax(0,1fr)_16rem]" aria-hidden="true">
        <div class="flex min-w-0 flex-col p-4 md:p-6">
          <div class="flex items-center gap-2 border-b border-line pb-3">
            <span class="text-label font-medium text-ink">Agent</span>
            <Badge variant="outline">Claude</Badge>
            <Badge variant="outline">Cursor</Badge>
            <Badge variant="outline">Codex</Badge>
          </div>
          <div class="min-h-0 flex-1 space-y-4 overflow-hidden py-4">
            <div class="ml-auto max-w-md rounded-md bg-sand px-3 py-2.5 text-small text-ink">
              Build a landing page for group bookings with our usual hero and FAQ.
            </div>
            <div class="max-w-md">
              <p class="text-label font-medium text-ink">Orso</p>
              <p class="mt-1 text-small leading-6 text-muted">
                Done. I reused the hero, pricing table and FAQ from the site, and left the copy as placeholders for
                review.
              </p>
              <div class="mt-3 space-y-1.5 rounded border border-line bg-surface p-3 font-mono text-label">
                <p class="text-ink">+ src/pages/group-bookings.astro</p>
                <p class="text-ink">+ src/content/pages/en/group-bookings.md</p>
                <p class="text-muted">~ src/site.ts</p>
              </div>
              <div class="mt-3 flex items-center gap-2">
                <Button size="sm">Open preview</Button>
                <Button size="sm" variant="outline">View changes</Button>
              </div>
            </div>
          </div>
          <div class="flex items-center gap-2 rounded-md border border-line bg-surface px-3 py-2">
            <span class="text-small text-muted">Ask for a change…</span>
            <Button size="xs" className="ml-auto">Send</Button>
          </div>
        </div>
        <aside class="hidden border-l border-line p-4 md:block">
          <p class="text-label font-medium text-ink">This draft</p>
          <div class="mt-3 overflow-hidden rounded border border-line">
            <div class="border-b border-line bg-sand px-2 py-1.5 text-label text-muted">group-bookings</div>
            <div class="p-3">
              <div class="h-1.5 w-16 rounded-full bg-ink"></div>
              <div class="mt-2 h-1.5 w-24 rounded-full bg-line"></div>
              <div class="mt-1 h-1.5 w-20 rounded-full bg-line"></div>
              <div class="mt-3 h-10 rounded bg-sand"></div>
            </div>
          </div>
          <p class="mt-4 text-label text-muted">3 files · +46 −2</p>
          <p class="mt-4 border-t border-line pt-3 text-label leading-5 text-muted">
            Use the agent your team already pays for. Orso only needs the repo.
          </p>
        </aside>
      </div>
    </AppWindow>
    </div>
  </div>
</section>
