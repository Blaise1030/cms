---
import UButton from "@nuxt/ui/components/Button.vue";
import ProductTabs from "../vue/ProductTabs.vue";
import DownloadButton from "../vue/DownloadButton.vue";
import { href } from "../../lib/href";
import { appShot } from "../../lib/appShots";

const shots = {
  content: await appShot("hero-content"),
  preview: await appShot("hero-preview"),
  publish: await appShot("hero-publish"),
  agent: await appShot("hero-agent"),
  history: await appShot("hero-history"),
};

const headline = "Let your content team edit the site with an agent.";
const words = headline.split(" ");
---

<section class="mx-auto max-w-7xl border-x border-line pt-14 md:pt-20" id="product">
  <div class="page">
    <div class="w-full md:max-w-3/4">
      <h1 class="text-display font-medium tracking-display text-ink">
        {words.map((word, index) => (
          <><span class="word" style={`--word-delay: ${index * 45}ms`}>{word}</span>{" "}</>
        ))}
      </h1>
      <p class="rise-2 mt-5 max-w-measure text-body text-muted md:mt-6">
        You own the repo, so every “can you change the pricing?” lands on you. With Orso, marketers, writers and
        founders make those changes themselves, in a form or by asking an agent. Each one is a pull request you review
        before it goes live.
      </p>
      <div id="get-orso" class="rise-3 mt-8 flex flex-wrap items-center gap-3">
        <DownloadButton client:load />
        <UButton color="neutral" variant="outline" size="lg" label="See what it does" to={href("#scale")} />
      </div>
      <p class="rise-3 mt-4 text-small text-muted">Free and open source. Content stays in your repo.</p>
    </div>
  </div>

  <div class="rise-3 mt-12 md:mt-16">
    <ProductTabs client:load shots={shots} />
  </div>
</section>
