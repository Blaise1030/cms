---
import { href } from "../../lib/href";

// Decorative draft card: shows the Orso change model (edit → preview → publish).
const changes = [
  { title: "Update the pricing FAQ", done: true },
  { title: "Swap the hero screenshot", done: true },
  { title: "Publish when ready", done: false },
];
---

<section class="page grid items-center gap-16 pt-14 pb-section md:grid-cols-12 md:gap-10 md:pt-24" id="hero">
  <div class="md:col-span-6">
    <p class="rise text-2xl font-medium tracking-tight text-ink md:text-3xl">Project Orso</p>
    <h1 class="rise mt-6 text-4xl font-light tracking-display text-ink md:text-5xl">
      Let your content team edit the site with an agent.
    </h1>
    <p class="rise-2 mt-6 max-w-measure text-lg text-muted">
      Your developer set up the repo. Now marketing, writers and founders can change the site themselves: in a form, or
      by asking an agent. Every change is a draft you preview before it goes live.
    </p>
    <div class="rise-3 mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
      <a class="button" href="https://github.com/Blaise1030/cms" rel="noopener noreferrer">Get Project Orso</a>
      <a class="link font-medium text-ink" href={href("#how-it-works")}>See how it works</a>
    </div>
    <p class="rise-3 mt-6 text-sm text-muted">Free and open source. Content stays in your repo.</p>
  </div>

  <div
    class="relative sm:pb-10 md:col-span-6 md:col-start-7 md:pb-0"
    role="img"
    aria-label="An example Orso draft: two edits done, publish waiting."
  >
    <div class="aspect-4/3 overflow-hidden rounded-xl bg-mist">
      <svg class="size-full" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <circle class="rise fill-glow" cx="292" cy="104" r="34" />
        <path class="rise fill-ridge" d="M0 196 38 168 70 182 116 136 158 174 204 116 248 166 288 148 330 176 372 154 400 168V216H0Z" />
        <g class="rise-2">
          <path class="fill-accent" d="M0 216c38-26 82-32 122-18 30 10 52 16 82 18Z" />
          <path class="fill-accent" d="M252 216c42-30 96-38 148-24v24Z" />
        </g>
        <rect class="fill-ridge/40" x="0" y="216" width="400" height="84" />
      </svg>
    </div>
    <div
      class="rise-3 absolute inset-x-4 -bottom-2 rounded-lg border border-line bg-surface-raised p-5 shadow-soft sm:inset-x-auto sm:right-6 sm:bottom-4 sm:w-72"
    >
      <p class="label">Draft · homepage</p>
      <p class="mt-2 text-sm font-medium text-ink">Preview ready</p>
      <ul class="mt-4 space-y-2.5">
        {changes.map((change) => (
          <li class="flex items-start gap-2.5 text-sm">
            <span
              class:list={[
                "mt-0.5 flex size-4 shrink-0 items-center justify-center rounded-full border",
                change.done ? "border-accent bg-accent text-on-accent" : "border-line-strong",
              ]}
              aria-hidden="true"
            >
              {change.done && (
                <svg class="size-2.5" viewBox="0 0 12 12"><path d="M2.5 6.5 5 9l4.5-5.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
              )}
            </span>
            <span class:list={[change.done ? "text-muted line-through" : "text-ink"]}>{change.title}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
