---
import UCard from "@nuxt/ui/components/Card.vue";
import Painting from "../Painting.astro";
import AppShot from "../vue/AppShot.vue";
import { appShot } from "../../lib/appShots";

const cards = [
  {
    title: "Drafts and checkpoints",
    description:
      "Every edit lands in a draft with a checkpoint you can restore. Nothing reaches the live site until someone presses Publish.",
    painting: "bridge" as const,
    shot: await appShot("how-drafts"),
    alt: "Orso's history: a timeline of checkpoints, newest first, with author, commit and time.",
  },
  {
    title: "Previews and review",
    description:
      "Share a preview link, leave comments on the page, and approve the change before it goes live — on desktop and mobile.",
    painting: "toledo" as const,
    shot: await appShot("how-review"),
    alt: "Orso previewing a draft, with the page details panel showing its title, description and social image.",
  },
  {
    title: "Agent in plain English",
    description:
      "Ask for a page, a pass on the FAQ, or a whole new section. The agent edits the repo; you still own Publish.",
    painting: "rocks" as const,
    shot: await appShot("how-agent"),
    alt: "Orso's agent panel next to the site preview, ready for a request.",
  },
];
---

<section class="mx-auto max-w-7xl border-x border-b border-line pt-section" id="how-it-works">
  <div class="page"><div class="w-full md:max-w-3/4">
    <p class="text-small font-medium text-muted">Their tools, your repo</p>
    <h2 class="mt-3 text-title tracking-display text-ink">
      Get the most out of your repo with tools the team can actually use
    </h2>
    <p class="mt-4 max-w-measure text-muted">
      The same files you already own, with drafts, previews and an agent on top. There's no second CMS to keep in sync.
    </p>
  </div></div>

  <ul class="mt-12 grid border-t border-line md:grid-cols-3">
    {cards.map((card) => (
      <li class="border-b border-line last:border-b-0 md:border-r md:border-b-0 md:last:border-r-0">
        <UCard
          variant="ghost"
          class="h-full rounded-none bg-transparent p-2"
          ui={{ header: "p-0 sm:p-0", body: "px-4 pt-5 pb-4 sm:px-4 sm:pt-5 sm:pb-4" }}
        >
          <div slot="header" class="relative aspect-4/3 overflow-hidden rounded-md border border-line">
            <Painting id={card.painting} />
            <div class="absolute inset-0 bg-night/20" aria-hidden="true"></div>
            <div class="relative flex size-full items-center justify-center p-3 md:p-4">
              <AppShot
                shot={card.shot}
                alt={card.alt}
                sizes="(min-width: 80rem) 25rem, (min-width: 48rem) 33vw, 100vw"
                class="h-full max-h-full w-auto max-w-full"
              />
            </div>
          </div>
          <h3 class="text-heading tracking-normal text-ink">{card.title}</h3>
          <p class="mt-1 text-small leading-6 text-muted">{card.description}</p>
        </UCard>
      </li>
    ))}
  </ul>
</section>
