---
import { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from "../ui/card";

const cards = [
  {
    title: "Drafts and checkpoints",
    description:
      "Every edit lands in a draft with a checkpoint you can restore. Nothing reaches the live site until someone presses Publish.",
    detail: "Branch → draft · Commit → checkpoint",
  },
  {
    title: "Previews and review",
    description:
      "Share a preview link, leave comments on the page, and approve the change before it goes live — on desktop and mobile.",
    detail: "Preview deploy → shareable link",
  },
  {
    title: "Agent in plain English",
    description:
      "Ask for a page, a pass on the FAQ, or a whole new section. The agent edits the repo; you still own Publish.",
    detail: "Claude, Cursor or Codex",
  },
];
---

<section class="page py-section" id="how-it-works">
  <div class="max-w-2xl">
    <p class="text-sm font-medium text-muted">Built for content teams</p>
    <h2 class="mt-3 text-3xl tracking-display text-ink md:text-4xl">
      Get the most out of your repo with tools the team can actually use
    </h2>
    <p class="mt-4 max-w-measure text-muted">
      The same files your developer owns, with drafts, previews and an agent on top — no second CMS to sync.
    </p>
  </div>

  <ul class="mt-12 grid gap-5 md:grid-cols-3">
    {cards.map((card) => (
      <li>
        <Card class="h-full rounded-md ring-line">
          <CardContent class="pt-(--card-spacing)">
            <div class="aspect-4/3 rounded-md border border-line bg-sand p-4" aria-hidden="true">
              <div class="h-full rounded-md border border-dashed border-line-strong bg-surface-raised p-3">
                <div class="h-2 w-16 rounded-full bg-ink"></div>
                <div class="mt-3 h-2 w-28 rounded-full bg-line"></div>
                <div class="mt-2 h-2 w-20 rounded-full bg-line"></div>
                <div class="mt-6 h-16 rounded bg-sand"></div>
              </div>
            </div>
          </CardContent>
          <CardHeader>
            <CardTitle class="text-xl text-ink">{card.title}</CardTitle>
            <CardDescription class="text-sm leading-6 text-muted">{card.description}</CardDescription>
          </CardHeader>
          <CardFooter class="font-mono text-xs text-muted">{card.detail}</CardFooter>
        </Card>
      </li>
    ))}
  </ul>
</section>
