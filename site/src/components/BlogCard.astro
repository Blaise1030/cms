---
import { Image } from "astro:assets";
import Artwork from "./Artwork.astro";
import { href } from "../lib/href";
import { categoriesOf, formatDate, type BlogCategory, type Post } from "../lib/blog";

interface Props {
  post: Post;
  categories: BlogCategory[];
  /** Heading level for the title: 2 in a page's main list, 3 under another section heading. */
  level?: 2 | 3;
  /** Extra classes for the grid cell this card sits in. */
  class?: string;
  /** Lower-case haystack used by the blog search. */
  search?: string;
}
const { post, categories, level = 2, class: className, search } = Astro.props;
const Heading = level === 3 ? "h3" : "h2";
const postCategories = categoriesOf(post, categories);
---

<article
  class:list={["group relative flex flex-col gap-5 bg-surface p-6 transition-colors duration-gentle ease-gentle hover:bg-sand lg:p-10", className]}
  data-blog-item
  data-search={search}
>
  <div class="overflow-hidden rounded-lg bg-sand">
    {post.data.coverImage ? (
      <Image
        class="aspect-16/10 w-full object-cover transition-transform duration-slow ease-settle group-hover:scale-102"
        src={post.data.coverImage}
        alt={post.data.coverAlt!}
        widths={[400, 800, 1200]}
        sizes="(min-width: 1024px) 26rem, (min-width: 640px) 50vw, 100vw"
      />
    ) : (
      <Artwork seed={post.id} class="aspect-16/10 w-full transition-transform duration-slow ease-settle group-hover:scale-102" />
    )}
  </div>
  <div class="flex flex-col gap-2">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
      <time class="label" datetime={post.data.pubDate}>{formatDate(post.data.pubDate)}</time>
      {postCategories.map((category) => (
        <a class="label relative z-10 transition-colors duration-quick ease-gentle hover:text-ink" href={href(`/blog/categories/${category.id}/`)}>{category.title}</a>
      ))}
    </div>
    <Heading class="text-heading tracking-tight text-ink">
      <a class="after:absolute after:inset-0" href={href(`/blog/${post.id}/`)}>{post.data.title}</a>
    </Heading>
    <p class="text-muted">{post.data.description}</p>
  </div>
</article>
