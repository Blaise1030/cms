---
// The title block at the top of inner pages: an optional back link, the page's single h1 and a
// short introduction. Extra content (filters, search) goes in the default slot.
import { href } from "../lib/href";

interface Props {
  title: string;
  description?: string;
  back?: { label: string; href: string };
}
const { title, description, back } = Astro.props;
---

<header class="page pt-14 md:pt-20">
  {back && <a class="link text-small text-muted" href={href(back.href)}>{back.label}</a>}
  <h1 class:list={["rise text-title tracking-display text-ink", back && "mt-6"]}>{title}</h1>
  {description && <p class="rise-2 mt-5 max-w-measure text-body text-muted">{description}</p>}
  <slot />
</header>
