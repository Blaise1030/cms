---
// A list of help articles as cards: title and one-line description, the whole card a link.
import UPageCard from "@nuxt/ui/components/PageCard.vue";
import { getI18n } from "../i18n";
import type { Doc } from "../lib/help";

interface Props {
  docs: Doc[];
}
const { docs } = Astro.props;
const { path } = getI18n(Astro.url);
---

<ul class="grid gap-3 sm:grid-cols-2">
  {docs.map((doc) => (
    <li class="flex">
      <UPageCard
        variant="outline"
        title={doc.data.title}
        description={doc.data.description}
        to={path(`/help/${doc.id}/`)}
        class="w-full rounded-lg bg-surface-raised transition-colors duration-gentle ease-gentle hover:bg-sand"
        ui={{
          container: "p-4 sm:p-4",
          title: "text-body font-medium text-ink",
          description: "mt-1 text-small text-muted",
        }}
      />
    </li>
  ))}
</ul>
