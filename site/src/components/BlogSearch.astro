---
// Client-side filter for the blog index: narrows the featured post and the card grid to posts
// whose title, description, tags or category contain every search term. The field stays hidden
// until the script runs, so visitors without JavaScript never see a dead input.
---

<div class="relative w-full sm:w-60" data-blog-search hidden>
  <label class="sr-only" for="blog-search-input">Search blog posts</label>
  <svg class="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-muted" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.75" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="m13 13 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
  <input
    id="blog-search-input"
    class="h-9 w-full rounded-full border border-line bg-sand py-1.5 pr-3 pl-9 text-small text-ink transition-colors duration-quick ease-gentle placeholder:text-muted hover:border-line-strong focus:border-line-strong focus:outline-none"
    type="search"
    placeholder="Search"
    autocomplete="off"
    aria-describedby="blog-search-status"
  />
  <p class="mt-1 text-label text-muted" id="blog-search-status" aria-live="polite"></p>
</div>

<script>
  // Runs on first load and after every client-side navigation (Astro view transitions).
  const setup = () => {
    for (const root of document.querySelectorAll<HTMLElement>("[data-blog-search]")) {
      if (root.dataset.ready) continue;
      root.dataset.ready = "true";
      const input = root.querySelector("input")!;
      const status = root.querySelector<HTMLElement>("[aria-live]")!;
      const items = [...document.querySelectorAll<HTMLElement>("[data-blog-item]")];
      const grid = document.querySelector<HTMLElement>("[data-blog-grid]");
      const empty = document.querySelector<HTMLElement>("[data-blog-empty]");

      const render = () => {
        const terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
        let shown = 0;
        for (const item of items) {
          const match = terms.every((term) => (item.dataset.search ?? "").includes(term));
          item.hidden = !match;
          if (match) shown += 1;
        }
        if (grid) grid.hidden = terms.length > 0 && shown === 0;
        if (empty) empty.hidden = shown > 0;
        status.textContent = terms.length === 0 ? "" : `${shown} ${shown === 1 ? "post" : "posts"} found.`;
      };

      input.addEventListener("input", render);
      input.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && input.value) {
          input.value = "";
          render();
        }
      });
      root.hidden = false;
    }
  };
  document.addEventListener("astro:page-load", setup);
</script>
