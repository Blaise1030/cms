---
// The application frame used by the hero demo and the platform tabs: a thin window bar, a
// breadcrumb and an optional status or actions, then the screen itself.
interface Props {
  crumbs: string[];
  class?: string;
}
const { crumbs, class: className } = Astro.props;
---

<div
  class:list={[
    "flex h-full min-h-0 flex-col overflow-hidden rounded-md border border-line bg-surface-raised",
    className,
  ]}
>
  <div class="flex min-h-11 shrink-0 items-center gap-2 border-b border-line px-4">
    <span class="font-mono text-xs tracking-tight text-muted">orso</span>
    {crumbs.map((crumb) => (
      <>
        <span class="text-line-strong" aria-hidden="true">/</span>
        <span class="truncate text-xs text-muted">{crumb}</span>
      </>
    ))}
    <div class="ml-auto flex items-center gap-3"><slot name="actions" /></div>
  </div>
  <div class="min-h-0 flex-1 overflow-hidden"><slot /></div>
  {Astro.slots.has("footer") && (
    <div class="flex min-h-12 shrink-0 items-center gap-3 border-t border-line px-4">
      <slot name="footer" />
    </div>
  )}
</div>
