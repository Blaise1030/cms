---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  /** `rail` is the sticky desktop column; `inline` is the collapsible mobile block. */
  variant: "rail" | "inline";
  /** Extra classes for the rail, so the page can place it in its grid. */
  class?: string;
}
const { headings, variant, class: className } = Astro.props;
const link =
  "block py-1.5 text-muted transition-colors duration-quick ease-gentle hover:text-ink aria-[current=true]:text-ink";
const indent = (depth: number) => (depth === 3 ? "pl-8" : "pl-4");
---

{variant === "rail" ? (
  <aside class:list={["hidden lg:block", className]}>
    <nav class="lg:sticky lg:top-28" aria-label="On this page" data-toc>
      <p class="label">On this page</p>
      <ul class="mt-4 border-l border-line text-sm">
        {headings.map((heading) => (
          <li>
            <a
              class:list={[
                "-ml-px border-l border-transparent aria-[current=true]:border-accent",
                link,
                indent(heading.depth),
              ]}
              href={`#${heading.slug}`}>{heading.text}</a
            >
          </li>
        ))}
      </ul>
    </nav>
  </aside>
) : (
  <details class="group mt-10 border-y border-line lg:hidden" data-toc>
    <summary class="flex cursor-pointer list-none items-center justify-between py-3 text-sm font-medium text-ink">
      On this page
      <svg class="size-4 text-muted transition-transform duration-quick ease-gentle group-open:rotate-180" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 8 5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </summary>
    <ul class="pb-2 text-sm">
      {headings.map((heading) => (
        <li><a class:list={[link, indent(heading.depth)]} href={`#${heading.slug}`}>{heading.text}</a></li>
      ))}
    </ul>
  </details>
)}
