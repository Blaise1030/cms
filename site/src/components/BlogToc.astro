---
import type { MarkdownHeading } from "astro";
import Icon from "./Icon.astro";

interface Props {
  headings: MarkdownHeading[];
  /** `rail` is the sticky desktop column; `inline` is the collapsible mobile block. */
  variant: "rail" | "inline";
  /** Extra classes for the rail, so the page can place it in its grid. */
  class?: string;
}
const { headings, variant, class: className } = Astro.props;
const link =
  "block py-1.5 text-muted transition-colors duration-quick ease-gentle hover:text-ink aria-[current=true]:text-ink";
const railLink =
  "block text-muted transition-colors duration-quick ease-gentle hover:text-ink aria-[current=true]:text-ink";
const indent =(depth: number) => (depth === 3 ? "pl-8" : "pl-4");
---

{variant === "rail" ? (
  <aside class:list={["hidden lg:block", className]}>
    <nav class="lg:sticky lg:top-28" aria-label="On this page" data-toc>
      <p class="text-small font-medium text-ink">On this page</p>
      <ul class="mt-3 flex flex-col gap-2 text-small">
        {headings.map((heading) => (
          <li>
            <a class:list={[railLink, heading.depth === 3 && "pl-3"]} href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  </aside>
) : (
  <details class="group mt-10 border-y border-line lg:hidden" data-toc>
    <summary class="flex cursor-pointer list-none items-center justify-between py-3 text-small font-medium text-ink">
      On this page
      <Icon name="chevron-down" class="size-4 text-muted transition-transform duration-quick ease-gentle group-open:rotate-180" />
    </summary>
    <ul class="pb-2 text-small">
      {headings.map((heading) => (
        <li><a class:list={[link, indent(heading.depth)]} href={`#${heading.slug}`}>{heading.text}</a></li>
      ))}
    </ul>
  </details>
)}
