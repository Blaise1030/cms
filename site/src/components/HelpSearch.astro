---
// Client-side search over the help articles listed on the page; no search service or build step.
// The field stays hidden until the script runs, so visitors without JavaScript never see a dead input.
import { href } from "../lib/href";
import type { Doc } from "../lib/help";

interface Props {
  docs: { doc: Doc; section: string }[];
}
const { docs } = Astro.props;
const plain = (markdown = "") =>
  markdown
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/[#>*_`|[\]()!~-]+/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .slice(0, 2000);
const index = docs.map(({ doc, section }) => ({
  section,
  title: doc.data.title,
  description: doc.data.description,
  href: href(`/help/${doc.id}/`),
  text: plain(doc.body),
}));
// `<` is escaped so article text can never close the JSON script element.
const json = JSON.stringify(index).replace(/</g, "\\u003c");
---

<div class="rise-3 mt-10 max-w-2xl" data-help-search hidden>
  <label class="sr-only" for="help-search-input">Search help</label>
  <div class="relative">
    <svg class="pointer-events-none absolute top-1/2 left-0 size-5 -translate-y-1/2 text-muted" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.75" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="m13 13 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
    <input
      id="help-search-input"
      class="w-full border-b border-muted bg-transparent py-3 pr-2 pl-8 text-body text-ink transition-colors duration-gentle ease-gentle placeholder:text-muted focus:border-accent focus:outline-none"
      type="search"
      placeholder="Search help, for example “invite”"
      autocomplete="off"
      aria-describedby="help-search-status"
    />
  </div>
  <p id="help-search-status" class="mt-4 text-small text-muted" aria-live="polite"></p>
  <ul class="divide-y divide-line" data-help-search-results></ul>
  <script type="application/json" data-help-search-index set:html={json}></script>
</div>

<script>
  type Entry = { title: string; description: string; section: string; href: string; text: string };

  // Runs on first load and after every client-side navigation (Astro view transitions).
  const setup = () => {
    for (const root of document.querySelectorAll<HTMLElement>("[data-help-search]")) {
      if (root.dataset.ready) continue;
      root.dataset.ready = "true";
      const input = root.querySelector("input")!;
      const status = root.querySelector<HTMLElement>("[aria-live]")!;
      const list = root.querySelector<HTMLUListElement>("[data-help-search-results]")!;
      const entries: Entry[] = JSON.parse(root.querySelector("[data-help-search-index]")?.textContent ?? "[]");
      const haystacks = entries.map((entry) => `${entry.title} ${entry.description} ${entry.section} ${entry.text}`.toLowerCase());

      const render = () => {
        const terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
        list.replaceChildren();
        if (terms.length === 0) {
          status.textContent = "";
          return;
        }
        const matches = entries
          .map((entry, i) => ({ entry, i }))
          .filter(({ i }) => terms.every((term) => haystacks[i].includes(term)))
          // Title matches first, then the page order.
          .sort((a, b) => Number(terms.some((t) => b.entry.title.toLowerCase().includes(t))) - Number(terms.some((t) => a.entry.title.toLowerCase().includes(t))) || a.i - b.i)
          .slice(0, 8);
        status.textContent = matches.length === 0 ? "No articles match your search. Try a shorter word." : `${matches.length} ${matches.length === 1 ? "article" : "articles"} found.`;
        for (const { entry } of matches) {
          const item = document.createElement("li");
          item.className = "py-4";
          const section = document.createElement("p");
          section.className = "label";
          section.textContent = entry.section;
          const link = document.createElement("a");
          link.className = "link mt-1 block font-medium text-ink";
          link.href = entry.href;
          link.textContent = entry.title;
          const meta = document.createElement("p");
          meta.className = "mt-1 text-small text-muted";
          meta.textContent = entry.description;
          item.append(section, link, meta);
          list.append(item);
        }
      };

      input.addEventListener("input", render);
      input.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && input.value) {
          input.value = "";
          render();
        }
      });
      root.hidden = false;
    }
  };
  document.addEventListener("astro:page-load", setup);
</script>
