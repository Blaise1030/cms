---
// Pagefind Component UI over one section's index (built by integrations/pagefind.js after
// `astro build`). Renders a search button that opens a search dialog (also on ⌘K / Ctrl+K).
// The index only exists in a build, so under `astro dev` the dialog shows no results.
interface Props {
  /** Index name from astro.config.mjs, e.g. "blog" → `<base>pagefind-blog/`. */
  bundle: string;
  /** Button label, also the dialog's input placeholder. */
  placeholder: string;
  class?: string;
}
const { bundle, placeholder, class: className } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const bundlePath = `${base}pagefind-${bundle}/`;
---

<link rel="stylesheet" href={`${bundlePath}pagefind-component-ui.css`} />
<div class:list={["search-theme", className]}>
  <pagefind-config instance={bundle} bundle-path={bundlePath} base-url={base}></pagefind-config>
  <pagefind-modal-trigger instance={bundle} placeholder={placeholder}></pagefind-modal-trigger>
  <!-- Stand-in bar until the Pagefind element upgrades (always under `astro dev`, where the
       index doesn't exist). Hidden by CSS once pagefind-modal-trigger is :defined. -->
  <div class="search-fallback" aria-hidden="true">
    <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
    <span class="truncate">{placeholder}</span>
  </div>
  <pagefind-modal instance={bundle} reset-on-close>
    <pagefind-modal-header>
      <pagefind-input instance={bundle} placeholder={placeholder}></pagefind-input>
    </pagefind-modal-header>
    <pagefind-modal-body>
      <pagefind-summary instance={bundle}></pagefind-summary>
      <pagefind-results instance={bundle} max-results="8" hide-sub-results></pagefind-results>
    </pagefind-modal-body>
    <pagefind-modal-footer>
      <pagefind-keyboard-hints instance={bundle}></pagefind-keyboard-hints>
    </pagefind-modal-footer>
  </pagefind-modal>
</div>
<script is:inline src={`${bundlePath}pagefind-component-ui.js`}></script>
