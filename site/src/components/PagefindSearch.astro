---
// Search over one section's Pagefind index (built by integrations/pagefind.js after
// `astro build`): a search button (or ⌘K / Ctrl+K) opens Nuxt UI's command palette
// (UCommandPalette in a UModal); type to list matching pages, pick one to open it. The index
// only exists in a build, so under `astro dev` the palette says search is unavailable.
import SiteSearch from "./vue/SiteSearch.vue";

interface Props {
  /** Index name from astro.config.mjs, e.g. "blog" → `<base>pagefind-blog/`. */
  bundle: string;
  /** Button label, palette placeholder and accessible name. */
  placeholder: string;
  class?: string;
}
const { bundle, placeholder, class: className } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<div class:list={[className]}>
  <SiteSearch client:idle bundlePath={`${base}pagefind-${bundle}/`} baseUrl={base} placeholder={placeholder} />
</div>
