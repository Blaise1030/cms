---
// An editorial placeholder for posts without a cover: a proof sheet of ruled lines with one
// pencil mark, drawn from the design tokens. `seed` varies the composition between cards.
interface Props {
  seed: string;
  class?: string;
}
const { seed, class: className } = Astro.props;
// FNV-1a: a small, stable hash so each post id gets its own composition.
const n = [...seed].reduce((hash, char) => Math.imul(hash ^ char.charCodeAt(0), 16777619) >>> 0, 2166136261);
const lines = 6 + (n % 4);
const title = 30 + ((n >>> 6) % 40);
const markX = 26 + ((n >>> 12) % 120);
---

<div class:list={["overflow-hidden bg-sand", className]} aria-hidden="true">
  <svg class="size-full" viewBox="0 0 300 200" preserveAspectRatio="xMidYMid slice">
    <rect class="fill-surface-raised" x="28" y="24" width="244" height="152" rx="2" />
    <rect class="fill-ink" x="50" y="48" width={title} height="7" rx="1" />
    <rect class="fill-line" x="50" y="66" width="150" height="3" rx="1" />
    <rect class="fill-line" x="50" y="78" width="182" height="3" rx="1" />
    <rect class="fill-line" x="50" y="90" width="128" height="3" rx="1" />
    {Array.from({ length: lines }).map((_, index) => (
      <rect class="fill-line" x="50" y={110 + index * 9} width={index === lines - 1 ? 96 : 190 - (index % 3) * 18} height="3" rx="1" />
    ))}
    <path class="stroke-accent" d={`M${markX} 104c18-6 38-6 56 0`} fill="none" stroke-width="2" stroke-linecap="round" />
    <rect class="fill-sand" x="212" y="48" width="40" height="40" rx="2" />
    <path class="stroke-line-strong" d="M222 58h20M222 66h14M222 74h18" fill="none" stroke-width="2" stroke-linecap="round" />
  </svg>
</div>
