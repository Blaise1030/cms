---
import { render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Artwork from "../../components/Artwork.astro";
import BlogCard from "../../components/BlogCard.astro";
import BlogToc from "../../components/BlogToc.astro";
import { href } from "../../lib/href";
import { categoriesOf, formatDate, loadBlog, morePosts } from "../../lib/blog";
import { absoluteUrl, breadcrumbs, organization } from "../../lib/seo";
import { site } from "../../site";

export async function getStaticPaths() {
  const { posts, categories } = await loadBlog();
  return posts.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, categories, newer: posts[index - 1], older: posts[index + 1], more: morePosts(entry, posts) },
  }));
}
const { entry, categories, newer, older, more } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const postCategories = categoriesOf(entry, categories);
const path = `/blog/${entry.id}/`;
const cover = entry.data.coverImage?.src;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: entry.data.title,
    description: entry.data.description,
    datePublished: entry.data.pubDate,
    dateModified: entry.data.pubDate,
    url: absoluteUrl(path),
    mainEntityOfPage: absoluteUrl(path),
    image: absoluteUrl(cover ?? site.ogImage),
    keywords: entry.data.tags.length > 0 ? entry.data.tags.join(", ") : undefined,
    author: { "@type": "Organization", name: site.name, url: absoluteUrl("/") },
    publisher: organization(),
  },
  breadcrumbs([{ name: "Home", path: "/" }, { name: "Blog", path: "/blog/" }, { name: entry.data.title, path }]),
];
const navLink = "group block border-t border-line pt-6";
---
<Base title={entry.data.title} description={entry.data.description} type="article" published={entry.data.pubDate} image={cover} imageAlt={entry.data.coverAlt} jsonLd={jsonLd}>
  <div class="mx-auto w-full max-w-7xl border-x border-b border-line pb-section">
    <article class="page pt-14 md:pt-20" data-pagefind-body>
      <div class="mx-auto max-w-5xl">
        <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
          <div class="min-w-0 lg:col-span-8">
            <a class="link text-small text-muted" href={href("/blog/")}>Back to Blog</a>
            <div class="rise mt-10 flex flex-wrap items-center gap-x-4 gap-y-1">
              <time class="label" datetime={entry.data.pubDate}>{formatDate(entry.data.pubDate)}</time>
              {postCategories.map((category) => (
                <a class="label text-accent transition-colors duration-quick ease-gentle hover:text-ink" href={href(`/blog/categories/${category.id}/`)}>{category.title}</a>
              ))}
            </div>
            <h1 class="rise mt-4 text-title tracking-display text-ink">{entry.data.title}</h1>
            <p class="rise-2 mt-6 max-w-prose text-body text-muted">{entry.data.description}</p>
            <div class="rise-3 mt-10 overflow-hidden rounded-lg bg-sand">
              {entry.data.coverImage ? (
                <Image class="aspect-16/9 w-full object-cover" src={entry.data.coverImage} alt={entry.data.coverAlt!} widths={[800, 1200, 1600]} sizes="(min-width: 1024px) 46rem, 100vw" loading="eager" />
              ) : (
                <Artwork seed={entry.id} class="aspect-16/9 w-full" />
              )}
            </div>
            {toc.length > 1 && <BlogToc headings={toc} variant="inline" />}
            <div
              class:list={[
                "prose mt-12 max-w-prose prose-img:h-auto prose-img:max-w-full prose-img:rounded-md",
                toc.length > 1 ? "lg:border-t lg:border-line lg:pt-10" : "border-t border-line pt-10",
              ]}
            ><Content /></div>
            {entry.data.tags.length > 0 && (
              <ul class="mt-10 flex max-w-prose flex-wrap gap-x-4 gap-y-1 text-small text-muted" aria-label="Tags">
                {entry.data.tags.map((tag) => <li>#{tag}</li>)}
              </ul>
            )}
            {(newer || older) && (
              <nav class="mt-16 grid max-w-prose gap-8 sm:grid-cols-2" aria-label="More posts" data-pagefind-ignore>
                <div>{newer && <a class={navLink} href={href(`/blog/${newer.id}/`)}><span class="label block">Newer</span><span class="mt-2 block font-medium text-ink decoration-line-strong underline-offset-4 group-hover:underline">{newer.data.title}</span></a>}</div>
                <div class="sm:text-right">{older && <a class={navLink} href={href(`/blog/${older.id}/`)}><span class="label block">Older</span><span class="mt-2 block font-medium text-ink decoration-line-strong underline-offset-4 group-hover:underline">{older.data.title}</span></a>}</div>
              </nav>
            )}
          </div>
          {toc.length > 1 && <BlogToc headings={toc} variant="rail" class="lg:col-span-3 lg:col-start-10" />}
        </div>
      </div>
    </article>
    {more.length > 0 && (
      <section class="mt-section" aria-labelledby="keep-reading">
        <div class="page"><h2 class="border-t border-line pt-12 text-title tracking-display text-ink" id="keep-reading">Keep reading</h2></div>
        <div class="mt-12 grid sm:max-lg:[&>*:nth-child(2n)]:border-r-0 sm:grid-cols-2 lg:[&>*:nth-child(3n)]:border-r-0 lg:grid-cols-3">{more.map((post) => <BlogCard post={post} categories={categories} level={3} class="border-b border-line sm:border-r" />)}</div>
      </section>
    )}
  </div>
</Base>

<script>
  // Marks each "On this page" link for the heading being read, in both TOC presentations.
  const track = () => {
    const tocs = [...document.querySelectorAll<HTMLElement>("[data-toc]")];
    if (tocs.length === 0 || !("IntersectionObserver" in window)) return;
    const links = new Map<string, HTMLAnchorElement[]>();
    for (const toc of tocs) {
      for (const link of toc.querySelectorAll<HTMLAnchorElement>("a[href^='#']")) {
        const id = decodeURIComponent(link.hash.slice(1));
        links.set(id, [...(links.get(id) ?? []), link]);
      }
    }
    const headings = [...links.keys()].map((id) => document.getElementById(id)).filter((el): el is HTMLElement => el !== null);
    const visible = new Set<string>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) entry.isIntersecting ? visible.add(entry.target.id) : visible.delete(entry.target.id);
        const current = headings.find((heading) => visible.has(heading.id));
        if (!current) return;
        for (const [id, anchors] of links) {
          for (const anchor of anchors) anchor.setAttribute("aria-current", String(id === current.id));
        }
      },
      { rootMargin: "-15% 0px -65% 0px" },
    );
    for (const heading of headings) observer.observe(heading);
    document.addEventListener("astro:before-swap", () => observer.disconnect(), { once: true });
  };
  document.addEventListener("astro:page-load", track);
</script>
