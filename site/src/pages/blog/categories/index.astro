---
import Base from "../../../layouts/Base.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { href } from "../../../lib/href";
import { loadBlog } from "../../../lib/blog";
import { breadcrumbs } from "../../../lib/seo";
const { categories } = await loadBlog();
---
<Base
  title="Blog categories"
  description="Browse Orso blog posts by topic: product news, practical guides and company stories."
  jsonLd={[{ "@context": "https://schema.org", "@type": "WebPage", name: "Blog categories" }, breadcrumbs([{ name: "Home", path: "/" }, { name: "Blog", path: "/blog/" }, { name: "Categories", path: "/blog/categories/" }])]}
>
  <div class="mx-auto w-full max-w-7xl flex-1 border-x border-b border-line pb-section" data-fill>
    <PageHeader title="Blog categories" back={{ label: "Back to Blog", href: "/blog/" }} />
    <div class="page mt-12">
      {categories.length === 0 ? <p class="text-muted">No blog categories yet.</p> : (
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">{categories.map((category) => (
          <li class="group relative flex flex-col gap-2 rounded-lg border border-line bg-surface-raised p-6 transition-colors duration-gentle ease-gentle hover:bg-sand">
            <p class="label">{category.posts.length} {category.posts.length === 1 ? "post" : "posts"}</p>
            <h2 class="text-heading tracking-tight text-ink">
              <a class="after:absolute after:inset-0" href={href(`/blog/categories/${category.id}/`)}>{category.title}</a>
            </h2>
            {category.description && <p class="text-muted">{category.description}</p>}
          </li>
        ))}</ul>
      )}
    </div>
  </div>
</Base>
