---
import LegalPage from "../components/LegalPage.astro";
import { site } from "../site";
---

<LegalPage title="Terms of service" description={`The terms that apply when you use ${site.name} and this website.`} path="/terms/" updated="2026-01-01">
  <p>These terms apply to your use of this website and the {site.name} product. By creating an account you agree to them.</p>
  <h2>Your account</h2>
  <p>You are responsible for the activity on your account and for keeping your sign-in details safe. Tell us straight away if you think someone else has access.</p>
  <h2>Your content</h2>
  <p>You own the projects and other content you add. You give {site.name} permission to store and display that content only so we can provide the service to you and the people you share it with.</p>
  <h2>Plans and payment</h2>
  <p>Paid plans are billed in advance each month. You can cancel at any time, and your plan stays active until the end of the period you have paid for.</p>
  <h2>Ending the service</h2>
  <p>You can close your account whenever you like. We may suspend accounts that break these terms, and we will tell you why.</p>
  <h2>Contact</h2>
  <p>Questions about these terms? Email legal@example.com.</p>
</LegalPage>
