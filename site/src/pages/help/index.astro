---
import Base from "../../layouts/Base.astro";
import DocList from "../../components/DocList.astro";
import PagefindSearch from "../../components/PagefindSearch.astro";
import PageHeader from "../../components/PageHeader.astro";
import { href } from "../../lib/href";
import { loadHelp } from "../../lib/help";
import { breadcrumbs } from "../../lib/seo";
const { sections, topics, docs } = await loadHelp();
const shown = sections.filter((section) => section.docs.length > 0);
const shownTopics = topics.filter((topic) => topic.docs.length > 0);
const count = (n: number) => `${n} ${n === 1 ? "article" : "articles"}`;
---
<Base
  title="Help"
  description="Guides and answers for using Orso, from connecting a repo to drafts, previews and Publish."
  jsonLd={[{ "@context": "https://schema.org", "@type": "WebPage", name: "Help" }, breadcrumbs([{ name: "Home", path: "/" }, { name: "Help", path: "/help/" }])]}
>
  <div class="mx-auto w-full max-w-7xl border-x border-line pb-section">
    <PageHeader title="Help" description="Guides and answers for every step, from your first sign-in to your next invoice.">
      {docs.length > 0 && <PagefindSearch bundle="help" variant="inline" placeholder="Search help, for example “invite”" class="rise-3 mt-10 max-w-2xl" />}
    </PageHeader>
    <div class="page">
      {docs.length === 0 ? <p class="mt-12 text-muted">No help docs yet. Check back soon for guides and answers.</p> : (
        <>
          <section class="mt-20" aria-labelledby="browse">
            <h2 class="label" id="browse">Browse by section</h2>
            <ul class="mt-6 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-3">{shown.map((section) => (
              <li class="group relative border-t border-line py-8">
                <h3 class="text-heading font-medium tracking-tight text-ink">
                  <a class="decoration-line-strong underline-offset-4 after:absolute after:inset-0 group-hover:underline" href={href(`/help/section/${section.id}/`)}>{section.title}</a>
                </h3>
                <p class="label mt-2">{count(section.docs.length)}</p>
                {section.description && <p class="mt-3 text-muted">{section.description}</p>}
              </li>
            ))}</ul>
            {shownTopics.length > 0 && (
              <nav class="mt-4 flex flex-wrap items-baseline gap-x-6 gap-y-2 border-t border-line pt-6 text-small" aria-label="Help topics">
                <span class="label">Topics</span>
                {shownTopics.map((topic) => <a class="link text-ink" href={href(`/help/categories/${topic.id}/`)}>{topic.title}</a>)}
              </nav>
            )}
          </section>
          {shown.map((section) => (
            <section class="mt-24 grid gap-6 md:grid-cols-12 md:gap-10">
              <div class="md:col-span-4">
                <h2 class="text-heading tracking-display text-ink">{section.title}</h2>
                <p class="label mt-2">{count(section.docs.length)}</p>
              </div>
              <div class="md:col-span-8"><DocList docs={section.docs} /></div>
            </section>
          ))}
        </>
      )}
    </div>
  </div>
</Base>
