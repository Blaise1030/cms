---
import Base from "../../layouts/Base.astro";
import HelpShell from "../../components/HelpShell.astro";
import Icon from "../../components/Icon.astro";
import { href } from "../../lib/href";
import { filterPill } from "../../lib/pill";
import { loadHelp } from "../../lib/help";
import { breadcrumbs } from "../../lib/seo";
const { sections, topics, docs } = await loadHelp();
const shown = sections.filter((section) => section.docs.length > 0);
const shownTopics = topics.filter((topic) => topic.docs.length > 0);
const count = (n: number) => `${n} ${n === 1 ? "article" : "articles"}`;
---
<Base
  title="Help"
  description="Guides and answers for using Orso, from connecting a repo to drafts, previews and Publish."
  jsonLd={[{ "@context": "https://schema.org", "@type": "WebPage", name: "Help" }, breadcrumbs([{ name: "Home", path: "/" }, { name: "Help", path: "/help/" }])]}
>
  <HelpShell current="/help/">
    <h1 class="text-title tracking-display text-ink">Help</h1>
    <p class="mt-4 max-w-prose text-body text-muted">Guides and answers for every step, from your first sign-in to your next invoice.</p>

    {docs.length === 0 ? <p class="mt-12 text-muted">No help docs yet. Check back soon for guides and answers.</p> : (
      <>
        <section class="mt-12" aria-labelledby="browse">
          <h2 class="text-heading tracking-tight text-ink" id="browse">Browse by section</h2>
          <ul class="mt-5 grid gap-3 sm:grid-cols-2">
            {shown.map((section) => (
              <li class="group relative flex items-center gap-3 rounded-lg border border-line bg-surface-raised px-4 py-3 transition-colors duration-gentle ease-gentle hover:bg-sand">
                <div class="min-w-0 flex-1">
                  <h3 class="font-medium text-ink">
                    <a class="after:absolute after:inset-0" href={href(`/help/section/${section.id}/`)}>{section.title}</a>
                  </h3>
                  <p class="text-small text-muted">{count(section.docs.length)}</p>
                </div>
                <Icon name="chevron-right" class="size-4 shrink-0 text-muted transition-transform duration-quick ease-gentle group-hover:translate-x-0.5" />
              </li>
            ))}
          </ul>
        </section>

        {shownTopics.length > 0 && (
          <nav class="mt-12" aria-labelledby="topics">
            <h2 class="text-heading tracking-tight text-ink" id="topics">Topics</h2>
            <div class="mt-4 flex flex-wrap gap-2">
              {shownTopics.map((topic) => <a class={filterPill} href={href(`/help/categories/${topic.id}/`)}>{topic.title}</a>)}
            </div>
          </nav>
        )}
      </>
    )}
  </HelpShell>
</Base>
