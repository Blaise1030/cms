---
import Base from "../../layouts/Base.astro";
import DocList from "../../components/DocList.astro";
import PagefindSearch from "../../components/PagefindSearch.astro";
import PageHeader from "../../components/PageHeader.astro";
import { href } from "../../lib/href";
import { filterPill } from "../../lib/pill";
import { loadHelp } from "../../lib/help";
import { breadcrumbs } from "../../lib/seo";
const { sections, topics, docs } = await loadHelp();
const shown = sections.filter((section) => section.docs.length > 0);
const shownTopics = topics.filter((topic) => topic.docs.length > 0);
const count = (n: number) => `${n} ${n === 1 ? "article" : "articles"}`;

---
<Base
  title="Help"
  description="Guides and answers for using Orso, from connecting a repo to drafts, previews and Publish."
  jsonLd={[{ "@context": "https://schema.org", "@type": "WebPage", name: "Help" }, breadcrumbs([{ name: "Home", path: "/" }, { name: "Help", path: "/help/" }])]}
>
  <div class="mx-auto w-full max-w-7xl border-x border-b border-line pb-section">
    <PageHeader title="Help" description="Guides and answers for every step, from your first sign-in to your next invoice.">
      {docs.length > 0 && <PagefindSearch bundle="help" placeholder="Search help, for example “invite”" class="rise-3 mt-10 max-w-2xl" />}
    </PageHeader>
    <div>
      {docs.length === 0 ? <p class="page mt-12 text-muted">No help docs yet. Check back soon for guides and answers.</p> : (
        <>
          <section class="mt-20" aria-labelledby="browse">
            <h2 class="page label" id="browse">Browse by section</h2>
            <ul class="-mx-px mt-6 flex snap-x snap-mandatory overflow-x-auto border-t border-l border-line sm:grid sm:snap-none sm:grid-cols-2 sm:overflow-visible lg:grid-cols-3">{shown.map((section) => (
              <li class="group relative w-4/5 shrink-0 snap-start border-r border-b border-line p-6 transition-colors sm:w-auto duration-gentle ease-gentle hover:bg-sand lg:p-8">
                <h3 class="text-heading font-medium tracking-tight text-ink">
                  <a class="after:absolute after:inset-0" href={href(`/help/section/${section.id}/`)}>{section.title}</a>
                </h3>
                <p class="label mt-2">{count(section.docs.length)}</p>
                {section.description && <p class="mt-3 text-muted">{section.description}</p>}
              </li>
            ))}</ul>
            {shownTopics.length > 0 && (
              <nav class="mt-6" aria-label="Help topics">
                <p class="page label">Topics</p>
                <div class="mt-3 flex gap-2 overflow-x-auto px-gutter py-1 md:flex-wrap md:overflow-visible md:px-gutter-wide">
                  {shownTopics.map((topic) => <a class={filterPill} href={href(`/help/categories/${topic.id}/`)}>{topic.title}</a>)}
                </div>
              </nav>
            )}
          </section>
          {shown.map((section) => (
            <section class="page mt-16 grid gap-6 border-t border-line pt-16 md:mt-20 md:grid-cols-12 md:gap-10 md:pt-20">
              <div class="md:col-span-4">
                <h2 class="text-heading tracking-display text-ink">{section.title}</h2>
                <p class="label mt-2">{count(section.docs.length)}</p>
              </div>
              <div class="md:col-span-8"><DocList docs={section.docs} /></div>
            </section>
          ))}
        </>
      )}
    </div>
  </div>
</Base>
