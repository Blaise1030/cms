---
import Base from "../../../layouts/Base.astro";
import { href } from "../../../lib/href";
import CtaBand from "../../../components/sections/CtaBand.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { loadHelp } from "../../../lib/help";
import { breadcrumbs } from "../../../lib/seo";

export async function getStaticPaths() {
  const { topics } = await loadHelp();
  return topics.map((topic) => ({ params: { slug: topic.id }, props: { topic } }));
}
const { topic } = Astro.props;
const description = topic.description ?? `Help articles about ${topic.title.toLowerCase()}.`;
---
<Base
  title={`Help topic: ${topic.title}`}
  description={description}
  jsonLd={[
    { "@context": "https://schema.org", "@type": "WebPage", name: topic.title, description },
    breadcrumbs([{ name: "Home", path: "/" }, { name: "Help", path: "/help/" }, { name: "Topics", path: "/help/categories/" }, { name: topic.title, path: `/help/categories/${topic.id}/` }]),
  ]}
>
  <div class="mx-auto w-full max-w-7xl border-x border-b border-line">
    <PageHeader title={topic.title} description={topic.description} back={{ label: "All topics", href: "/help/categories/" }} />
    <div class="page mt-12">
      {topic.docs.length === 0 ? <p class="text-muted">No articles on this topic yet.</p> : (
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">{topic.docs.map((doc) => (
          <li class="group relative flex flex-col gap-2 rounded-lg border border-line bg-surface-raised p-6 transition-colors duration-gentle ease-gentle hover:bg-sand">
            <h2 class="text-heading tracking-tight text-ink">
              <a class="after:absolute after:inset-0" href={href(`/help/${doc.id}/`)}>{doc.data.title}</a>
            </h2>
            {doc.data.description && <p class="text-muted">{doc.data.description}</p>}
          </li>
        ))}</ul>
      )}
    </div>
    <CtaBand class="mt-section border-t border-line" />
  </div>
</Base>
