---
import Base from "../../../layouts/Base.astro";
import CtaBand from "../../../components/sections/CtaBand.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { href } from "../../../lib/href";
import { loadHelp } from "../../../lib/help";
import { breadcrumbs } from "../../../lib/seo";
const { topics } = await loadHelp();
---
<Base
  title="Help topics"
  description="Browse Orso help articles by topic, such as setup, collaboration and troubleshooting."
  jsonLd={[{ "@context": "https://schema.org", "@type": "WebPage", name: "Help topics" }, breadcrumbs([{ name: "Home", path: "/" }, { name: "Help", path: "/help/" }, { name: "Topics", path: "/help/categories/" }])]}
>
  <div class="mx-auto w-full max-w-7xl border-x border-b border-line">
    <PageHeader title="Help topics" back={{ label: "Back to Help", href: "/help/" }} />
    <div class="page mt-12">
      {topics.length === 0 ? <p class="text-muted">No help topics yet.</p> : (
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">{topics.map((topic) => (
          <li class="group relative flex flex-col gap-2 rounded-lg border border-line bg-surface-raised p-6 transition-colors duration-gentle ease-gentle hover:bg-sand">
            <p class="label">{topic.docs.length} {topic.docs.length === 1 ? "article" : "articles"}</p>
            <h2 class="text-heading tracking-tight text-ink">
              <a class="after:absolute after:inset-0" href={href(`/help/categories/${topic.id}/`)}>{topic.title}</a>
            </h2>
            {topic.description && <p class="text-muted">{topic.description}</p>}
          </li>
        ))}</ul>
      )}
    </div>
    <CtaBand class="mt-section border-t border-line" />
  </div>
</Base>
