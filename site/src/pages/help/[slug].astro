---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import BlogToc from "../../components/BlogToc.astro";
import HelpShell from "../../components/HelpShell.astro";
import Icon from "../../components/Icon.astro";
import { href } from "../../lib/href";
import UBadge from "@nuxt/ui/components/Badge.vue";
import { loadHelp } from "../../lib/help";
import { absoluteUrl, breadcrumbs, organization } from "../../lib/seo";

export async function getStaticPaths() {
  const { docs, sectionOf, topics } = await loadHelp();
  return docs.map((entry, index) => {
    const section = sectionOf(entry);
    return {
      params: { slug: entry.id },
      props: {
        entry,
        section: { id: section.id, title: section.title },
        subsection: section.subsections.find((sub) => sub.id === entry.data.subcategory)?.title,
        topic: topics.find((topic) => topic.id === entry.data.category),
        previous: docs[index - 1],
        next: docs[index + 1],
      },
    };
  });
}
const { entry, section, subsection, topic, previous, next } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const path = `/help/${entry.id}/`;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: entry.data.title,
    description: entry.data.description,
    url: absoluteUrl(path),
    mainEntityOfPage: absoluteUrl(path),
    articleSection: section.title,
    publisher: organization(),
  },
  breadcrumbs([
    { name: "Home", path: "/" },
    { name: "Help", path: "/help/" },
    { name: section.title, path: `/help/section/${section.id}/` },
    { name: entry.data.title, path },
  ]),
];
const navLink = "group flex items-start gap-3 rounded-lg border border-line px-4 py-3 transition-colors duration-gentle ease-gentle hover:bg-sand";
const crumbs = [
  { label: "Help", href: "/help/" },
  { label: section.title, href: `/help/section/${section.id}/` },
  ...(subsection ? [{ label: subsection }] : []),
];
---
<Base title={entry.data.title} description={entry.data.description} type="article" jsonLd={jsonLd}>
  <HelpShell current={path} crumbs={crumbs}>
    <article data-pagefind-body>
      <h1 class="rise mt-4 text-title tracking-display text-ink">{entry.data.title}</h1>
      <p class="rise-2 mt-4 max-w-prose text-body text-muted">{entry.data.description}</p>
      {topic && <p class="mt-4"><UBadge as="a" color="neutral" variant="outline" class="relative z-10" href={href(`/help/categories/${topic.id}/`)} label={topic.title} /></p>}
      {toc.length > 1 && <BlogToc headings={toc} variant="inline" class="xl:hidden" />}
      <div class="prose mt-10 max-w-prose prose-img:h-auto prose-img:max-w-full prose-img:rounded-md"><Content /></div>
    </article>
    {(previous || next) && (
      <nav class="mt-14 grid gap-3 border-t border-line pt-8 sm:grid-cols-2" aria-label="More articles" data-pagefind-ignore>
        <div>{previous && (
          <a class={navLink} href={href(`/help/${previous.id}/`)}>
            <Icon name="arrow-left" class="mt-0.5 size-4 shrink-0 text-muted transition-transform duration-quick ease-gentle group-hover:-translate-x-0.5" />
            <span class="min-w-0"><span class="block text-small text-muted">Previous</span><span class="mt-0.5 block font-medium text-ink">{previous.data.title}</span></span>
          </a>
        )}</div>
        <div>{next && (
          <a class:list={[navLink, "justify-end text-right"]} href={href(`/help/${next.id}/`)}>
            <span class="min-w-0"><span class="block text-small text-muted">Next</span><span class="mt-0.5 block font-medium text-ink">{next.data.title}</span></span>
            <Icon name="arrow-right" class="mt-0.5 size-4 shrink-0 text-muted transition-transform duration-quick ease-gentle group-hover:translate-x-0.5" />
          </a>
        )}</div>
      </nav>
    )}
    {toc.length > 1 && (
      <nav slot="rail" aria-label="On this page" data-toc>
        <p class="text-small font-medium text-ink">On this page</p>
        <ul class="mt-3 flex flex-col gap-2 text-small">
          {toc.map((heading) => (
            <li>
              <a class:list={["block text-muted transition-colors duration-quick ease-gentle hover:text-ink aria-[current=true]:text-ink", heading.depth === 3 && "pl-3"]} href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </HelpShell>
</Base>

<script>
  // Marks each "On this page" link (rail and mobile list) for the heading being read.
  const track = () => {
    const tocs = [...document.querySelectorAll<HTMLElement>("[data-toc]")];
    if (tocs.length === 0 || !("IntersectionObserver" in window)) return;
    const links = new Map<string, HTMLAnchorElement[]>();
    for (const toc of tocs) {
      for (const link of toc.querySelectorAll<HTMLAnchorElement>("a[href^='#']")) {
        const id = decodeURIComponent(link.hash.slice(1));
        links.set(id, [...(links.get(id) ?? []), link]);
      }
    }
    const headings = [...links.keys()].map((id) => document.getElementById(id)).filter((el): el is HTMLElement => el !== null);
    const visible = new Set<string>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) entry.isIntersecting ? visible.add(entry.target.id) : visible.delete(entry.target.id);
        const current = headings.find((heading) => visible.has(heading.id));
        if (!current) return;
        for (const [id, anchors] of links) {
          for (const anchor of anchors) anchor.setAttribute("aria-current", String(id === current.id));
        }
      },
      { rootMargin: "-15% 0px -65% 0px" },
    );
    for (const heading of headings) observer.observe(heading);
    document.addEventListener("astro:before-swap", () => observer.disconnect(), { once: true });
  };
  document.addEventListener("astro:page-load", track);
</script>
