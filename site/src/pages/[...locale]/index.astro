---
import AgentBand from "../../components/sections/AgentBand.astro";
import Cta from "../../components/sections/Cta.astro";
import Faq from "../../components/sections/Faq.astro";
import Features from "../../components/sections/Features.astro";
import Hero from "../../components/sections/Hero.astro";
import Logos from "../../components/sections/Logos.astro";
import Ops from "../../components/sections/Ops.astro";
import Proof from "../../components/sections/Proof.astro";
import Base from "../../layouts/Base.astro";
import { organization, website } from "../../lib/seo";
import { getI18n, localeStaticPaths } from "../../i18n";

export const getStaticPaths = localeStaticPaths;
const { t } = getI18n(Astro.url);
---

<Base description={t("site.description")} jsonLd={[website(), organization()]}>
  <Hero />
  <Logos />
  <Ops />
  <Features />
  <AgentBand />
  <Proof />
  <Faq />
  <Cta />
</Base>
