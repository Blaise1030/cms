---
import Base from "../../../../layouts/Base.astro";
import CtaBand from "../../../../components/sections/CtaBand.astro";
import PageHeader from "../../../../components/PageHeader.astro";
import { loadHelp } from "../../../../lib/help";
import { breadcrumbs } from "../../../../lib/seo";
import { getI18n, localeStaticPaths } from "../../../../i18n";

export const getStaticPaths = localeStaticPaths;
const { t, path, sitePath, locale } = getI18n(Astro.url);
const { topics } = await loadHelp(locale);
---
<Base
  title={t("help.topicsPage.title")}
  description={t("help.topicsPage.description")}
  jsonLd={[{ "@context": "https://schema.org", "@type": "WebPage", name: t("help.topicsPage.title") }, breadcrumbs([{ name: t("common.home"), path: sitePath("/") }, { name: t("help.title"), path: sitePath("/help/") }, { name: t("help.topics"), path: sitePath("/help/categories/") }])]}
>
  <div class="mx-auto w-full max-w-7xl border-x border-b border-line">
    <PageHeader title={t("help.topicsPage.title")} back={{ label: t("help.topicsPage.back"), href: "/help/" }} />
    <div class="page mt-12">
      {topics.length === 0 ? <p class="text-muted">{t("help.topicsPage.empty")}</p> : (
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">{topics.map((topic) => (
          <li class="group relative flex flex-col gap-2 rounded-lg border border-line bg-surface-raised p-6 transition-colors duration-gentle ease-gentle hover:bg-sand">
            <p class="label">{t("help.articleCount", { count: topic.docs.length })}</p>
            <h2 class="text-heading tracking-tight text-ink">
              <a class="after:absolute after:inset-0" href={path(`/help/categories/${topic.id}/`)}>{topic.title}</a>
            </h2>
            {topic.description && <p class="text-muted">{topic.description}</p>}
          </li>
        ))}</ul>
      )}
    </div>
    <CtaBand class="mt-section border-t border-line" />
  </div>
</Base>
