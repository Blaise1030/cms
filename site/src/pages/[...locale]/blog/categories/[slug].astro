---
import Base from "../../../../layouts/Base.astro";
import BlogCard from "../../../../components/BlogCard.astro";
import BlogFilters from "../../../../components/BlogFilters.astro";
import PageHeader from "../../../../components/PageHeader.astro";
import { loadBlog, searchText } from "../../../../lib/blog";
import { breadcrumbs } from "../../../../lib/seo";
import { getI18n, localizedStaticPaths } from "../../../../i18n";

export const getStaticPaths = () =>
  localizedStaticPaths(async (locale) => {
    const { categories } = await loadBlog(locale);
    return categories.map((category) => ({ params: { slug: category.id }, props: { category, categories } }));
  });
const { category, categories } = Astro.props;
const { t, sitePath } = getI18n(Astro.url);
const description = category.description ?? t("blog.category.description", { title: category.title });
---
<Base
  title={t("blog.category.title", { title: category.title })}
  description={description}
  jsonLd={[
    { "@context": "https://schema.org", "@type": "WebPage", name: category.title, description },
    breadcrumbs([{ name: t("common.home"), path: sitePath("/") }, { name: t("blog.title"), path: sitePath("/blog/") }, { name: category.title, path: sitePath(`/blog/categories/${category.id}/`) }]),
  ]}
>
  <div class="mx-auto w-full max-w-7xl flex-1 border-x border-b border-line pb-section" data-fill>
    <PageHeader title={category.title} description={category.description} back={{ label: t("blog.categories.all"), href: "/blog/categories/" }} />
    <div class="mt-12 border-y border-line">
      <div class="page flex flex-col gap-4 py-6 lg:flex-row lg:items-center lg:justify-between lg:py-8">
        <h2 class="text-heading tracking-tight text-ink">{t("blog.posts")}</h2>
        <BlogFilters categories={categories} active={category.id} />
      </div>
    </div>
    {category.posts.length === 0 ? <p class="page py-16 text-muted">{t("blog.category.empty")}</p> : (
      <div class="grid sm:max-lg:[&>*:nth-child(2n)]:border-r-0 sm:grid-cols-2 lg:[&>*:nth-child(3n)]:border-r-0 lg:grid-cols-3">
        {category.posts.map((post) => <BlogCard post={post} categories={categories} search={searchText(post, categories)} class="border-b border-line sm:border-r" />)}
      </div>
    )}
  </div>
</Base>
