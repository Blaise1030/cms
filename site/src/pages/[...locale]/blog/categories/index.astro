---
import Base from "../../../../layouts/Base.astro";
import PageHeader from "../../../../components/PageHeader.astro";
import { loadBlog } from "../../../../lib/blog";
import { breadcrumbs } from "../../../../lib/seo";
import { getI18n, localeStaticPaths } from "../../../../i18n";

export const getStaticPaths = localeStaticPaths;
const { t, path, sitePath, locale } = getI18n(Astro.url);
const { categories } = await loadBlog(locale);
---
<Base
  title={t("blog.categories.title")}
  description={t("blog.categories.description")}
  jsonLd={[{ "@context": "https://schema.org", "@type": "WebPage", name: t("blog.categories.title") }, breadcrumbs([{ name: t("common.home"), path: sitePath("/") }, { name: t("blog.title"), path: sitePath("/blog/") }, { name: t("blog.categories.crumb"), path: sitePath("/blog/categories/") }])]}
>
  <div class="mx-auto w-full max-w-7xl flex-1 border-x border-b border-line pb-section" data-fill>
    <PageHeader title={t("blog.categories.title")} back={{ label: t("blog.categories.back"), href: "/blog/" }} />
    <div class="page mt-12">
      {categories.length === 0 ? <p class="text-muted">{t("blog.categories.empty")}</p> : (
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">{categories.map((category) => (
          <li class="group relative flex flex-col gap-2 rounded-lg border border-line bg-surface-raised p-6 transition-colors duration-gentle ease-gentle hover:bg-sand">
            <p class="label">{t("blog.postCount", { count: category.posts.length })}</p>
            <h2 class="text-heading tracking-tight text-ink">
              <a class="after:absolute after:inset-0" href={path(`/blog/categories/${category.id}/`)}>{category.title}</a>
            </h2>
            {category.description && <p class="text-muted">{category.description}</p>}
          </li>
        ))}</ul>
      )}
    </div>
  </div>
</Base>
