---
import LegalPage from "../components/LegalPage.astro";
import { site } from "../site";
---

<LegalPage title="Privacy policy" description={`How ${site.name} collects, uses and protects personal information.`} path="/privacy/" updated="2026-01-01">
  <p>This policy explains what personal information {site.name} collects when you use this website and the {site.name} product, why we collect it, and the choices you have.</p>
  <h2>What we collect</h2>
  <ul>
    <li><strong>Account details</strong> such as your name and email address when you sign up.</li>
    <li><strong>Content you add</strong>, including projects, tasks and comments.</li>
    <li><strong>Usage information</strong> such as pages visited and the browser you use, collected to keep the service working.</li>
  </ul>
  <h2>How we use it</h2>
  <p>We use this information to run the service, answer support requests, send the emails you have asked for and improve the product. We do not sell personal information.</p>
  <h2>Your choices</h2>
  <p>You can update or delete your account at any time from your settings. To ask for a copy of your data, or to ask a question about this policy, email privacy@example.com.</p>
  <h2>Changes to this policy</h2>
  <p>When we change this policy we update the date above, and we tell account holders by email about any significant change.</p>
</LegalPage>
