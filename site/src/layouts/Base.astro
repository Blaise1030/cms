---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Wordmark from "../components/Wordmark.astro";
import { href } from "../lib/href";
import { absoluteUrl, themeColors } from "../lib/seo";
import { site } from "../site";
import "../styles/global.css";

interface Props {
  /** Page title; " | Project Orso" is appended. Omit on the home page to get "Project Orso | tagline". */
  title?: string;
  /** Meta description; defaults to `site.description`. */
  description?: string;
  /** Social card image (a `public/` path or absolute URL); defaults to `site.ogImage`. */
  image?: string;
  /** Alt text for the social card image. */
  imageAlt?: string;
  /** `article` for blog posts and help docs, `website` otherwise. */
  type?: "website" | "article";
  /** schema.org objects, each rendered as its own JSON-LD block. Defaults to a WebPage. */
  jsonLd?: Record<string, unknown>[];
  /** Article dates (YYYY-MM-DD) for Open Graph. */
  published?: string;
  /** Keep the page out of search results. */
  noindex?: boolean;
}
const {
  title,
  description = site.description,
  image = site.ogImage,
  imageAlt = `${site.name}: ${site.tagline}`,
  type = "website",
  published,
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = absoluteUrl(image);
const jsonLd = Astro.props.jsonLd ?? [
  { "@context": "https://schema.org", "@type": "WebPage", name: title ?? site.name, description, url: canonical },
];
const base = import.meta.env.BASE_URL;
// The nav item for the section being viewed (Blog or Help) gets aria-current.
const here = Astro.url.pathname.slice(base.replace(/\/$/, "").length);
const isCurrent = (link: string) => link.startsWith("/") && link !== "/" && here.startsWith(link);
const product = site.nav.filter((link) => link.href.startsWith("#"));
const resources = site.nav.filter((link) => !link.href.startsWith("#"));
const external = (link: string) => /^https?:\/\//.test(link);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {image === site.ogImage && <meta property="og:image:width" content="1200" />}
    {image === site.ogImage && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={imageAlt} />
    {published && <meta property="article:published_time" content={published} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={themeColors.light} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={themeColors.dark} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="sitemap" href={`${base}sitemap.xml`} />
    <Font cssVariable="--font-geist" preload={[{ style: "normal" }]} />
    {jsonLd.map((data) => <script type="application/ld+json" is:inline set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />)}
    <ClientRouter fallback="swap" />
  </head>
  <body class="flex min-h-dvh flex-col bg-surface font-sans text-ink antialiased">
    <a
      class="sr-only rounded-md bg-accent px-4 py-2 text-on-accent focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50"
      href="#main">Skip to content</a
    >
    <header class="sticky top-0 z-40 border-b border-line bg-surface/90 backdrop-blur-md" transition:animate="none">
      <div class="page flex min-h-header flex-wrap items-center gap-x-10 gap-y-1 py-3 md:flex-nowrap">
        <a class="-m-1 rounded-sm p-1" href={base} aria-label={`${site.name} home`}><Wordmark /></a>
        <nav class="order-last -mx-2 flex w-full gap-1 overflow-x-auto md:order-none md:w-auto" aria-label="Main">
          {site.nav.map((link) => (
            <a
              class="shrink-0 rounded-sm px-2 py-1 text-sm text-muted transition-colors duration-quick ease-gentle hover:text-ink aria-[current=page]:text-ink"
              href={href(link.href)}
              aria-current={isCurrent(link.href) ? "page" : undefined}>{link.label}</a
            >
          ))}
        </nav>
        {site.cta && (
          <a
            class="ml-auto shrink-0 rounded-full bg-accent px-4 py-1.5 text-sm font-medium text-on-accent transition-colors duration-quick ease-gentle hover:bg-accent-hover"
            href={href(site.cta.href)}>{site.cta.label}</a
          >
        )}
      </div>
    </header>

    <main id="main" class="flex-1"><slot /></main>

    <footer class="mt-section border-t border-line">
      <div class="page grid gap-12 py-16 md:grid-cols-12">
        <div class="md:col-span-5">
          <Wordmark />
          <p class="mt-4 max-w-sm text-sm text-muted">{site.description}</p>
        </div>
        <nav class="grid grid-cols-2 gap-8 sm:grid-cols-4 md:col-span-7" aria-label="Footer">
          {[
            { title: "Product", links: product },
            { title: "Resources", links: resources },
            { title: "Company", links: site.footer.links },
            { title: "Follow", links: site.socials },
          ].filter((group) => group.links.length > 0).map((group) => (
            <div>
              <p class="label">{group.title}</p>
              <ul class="mt-4 space-y-2 text-sm">
                {group.links.map((link) => (
                  <li>
                    <a
                      class="text-muted transition-colors duration-quick ease-gentle hover:text-ink"
                      href={href(link.href)}
                      rel={external(link.href) ? "noopener noreferrer" : undefined}>{link.label}</a
                    >
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </div>
      <div class="page">
        <p class="border-t border-line py-6 text-xs text-muted">{site.footer.text}</p>
      </div>
    </footer>

    <script>
      // Sections marked data-reveal fade in when they first scroll into view. Only sections
      // that start below the fold are hidden, and only once this script runs, so content is
      // always visible without JavaScript. Runs again after every client-side navigation.
      const reveal = () => {
        if (!("IntersectionObserver" in window) || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("reveal-in");
              entry.target.classList.remove("reveal-pending");
              observer.unobserve(entry.target);
            }
          },
          // The huge top margin counts anything above the viewport as seen, so sections skipped
          // by a jump (an anchor link, the End key) are never left hidden.
          { rootMargin: "100000px 0px -8% 0px" },
        );
        for (const element of document.querySelectorAll<HTMLElement>("[data-reveal]")) {
          if (element.getBoundingClientRect().top < window.innerHeight * 0.92) continue;
          element.classList.add("reveal-pending");
          observer.observe(element);
        }
      };
      document.addEventListener("astro:page-load", reveal);
    </script>
  </body>
</html>
